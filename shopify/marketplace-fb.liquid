{%- comment -%}
  Marketplace facon Facebook (turquoise) — IATECHFUTUR.
  Vues : « Tout parcourir » (grille d'annonces depuis le catalogue) + « Mes ventes ».
  Bouton « Ajouter un article » -> formulaire de contact natif Shopify (envoie l'annonce par e-mail).
{%- endcomment -%}
{%- assign mp = collections.all -%}
{%- assign city = shop.address.city | default: 'Belgique' -%}
<style>
  .fbm *{box-sizing:border-box;}
  .fbm{--tq:#13B5C4;--tq-d:#0E7C86;--tq-bg:#E6FAFC;display:flex;gap:18px;max-width:1600px;margin:0 auto;padding:6px 0 20px;font-family:Arial,Helvetica,sans-serif;color:#0F1111;}
  .fbm__side{flex:0 0 300px;max-width:300px;}
  .fbm__brandrow{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;}
  .fbm__brand{font-size:24px;font-weight:800;margin:0;color:#0F1111;}
  .fbm__gear{width:34px;height:34px;border-radius:50%;background:#eef0f1;display:flex;align-items:center;justify-content:center;font-size:16px;}
  .fbm__search{margin-bottom:14px;}
  .fbm__search input{width:100%;border:none;background:#eef0f1;border-radius:100px;padding:10px 14px;font-size:14px;outline:none;}
  .fbm__nav{display:flex;flex-direction:column;gap:2px;margin-bottom:12px;}
  .fbm__navitem{display:flex;align-items:center;gap:12px;padding:9px 10px;border-radius:8px;color:#0F1111;text-decoration:none;font-size:15px;font-weight:600;cursor:pointer;background:none;border:none;text-align:left;width:100%;}
  .fbm__navitem:hover{background:#f0f2f5;}
  .fbm__navitem.is-active{color:var(--tq-d);background:var(--tq-bg);}
  .fbm__ico{width:34px;height:34px;border-radius:50%;background:#eef0f1;display:flex;align-items:center;justify-content:center;font-size:16px;flex:0 0 auto;}
  .fbm__navitem.is-active .fbm__ico{background:var(--tq);color:#fff;}
  .fbm__add{width:100%;background:var(--tq);color:#fff;border:none;border-radius:8px;padding:11px;font-size:15px;font-weight:700;cursor:pointer;margin-bottom:16px;}
  .fbm__add:hover{background:var(--tq-d);}
  .fbm__block{border-top:1px solid #e4e6e9;padding-top:12px;margin-bottom:12px;}
  .fbm__blocktitle{font-size:17px;font-weight:800;margin-bottom:8px;}
  .fbm__loc{font-size:14px;color:#333;}
  .fbm__cats{list-style:none;margin:0;padding:0;}
  .fbm__cats a{display:flex;align-items:center;gap:12px;padding:8px 10px;border-radius:8px;color:#0F1111;text-decoration:none;font-size:14px;}
  .fbm__cats a:hover{background:#f0f2f5;}
  .fbm__main{flex:1;min-width:0;}
  .fbm__mainhead{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
  .fbm__mainhead h2{font-size:20px;font-weight:800;margin:0;}
  .fbm__pin{color:var(--tq-d);font-size:14px;font-weight:600;}
  .fbm__grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;}
  .fbm__card{text-decoration:none;color:#0F1111;display:flex;flex-direction:column;}
  .fbm__img{display:block;width:100%;aspect-ratio:1/1;background:#f0f2f5;border-radius:10px;overflow:hidden;}
  .fbm__img img{width:100%;height:100%;object-fit:cover;display:block;}
  .fbm__price{font-weight:800;font-size:16px;margin:6px 0 2px;}
  .fbm__t{font-size:14px;line-height:1.25;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
  .fbm__city{font-size:12px;color:#65676b;margin-top:2px;}
  .fbm__sales{display:flex;gap:18px;}
  .fbm__salesnav{flex:0 0 280px;}
  .fbm__empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:#65676b;padding:50px 20px;}
  .fbm__plane{font-size:50px;color:var(--tq);}
  .fbm__modal{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;align-items:flex-start;justify-content:center;z-index:1400;padding:24px;overflow:auto;}
  .fbm__modal.is-open{display:flex;}
  .fbm__dialog{background:#fff;border-radius:14px;max-width:560px;width:100%;padding:22px;margin:auto;}
  .fbm__dialog h2{margin:0 0 4px;font-size:20px;color:var(--tq-d);}
  .fbm__dialog label{display:block;font-weight:600;font-size:14px;margin:12px 0 4px;}
  .fbm__dialog input,.fbm__dialog select,.fbm__dialog textarea{width:100%;padding:10px;border:1px solid #ccd0d5;border-radius:8px;font-size:14px;background:#fff;color:#0F1111;}
  .fbm__rowf{display:flex;gap:12px;}
  .fbm__rowf>div{flex:1;}
  .fbm__submit{background:var(--tq);color:#fff;border:none;border-radius:100px;padding:12px 24px;font-size:15px;font-weight:700;cursor:pointer;}
  .fbm__submit:hover{background:var(--tq-d);}
  .fbm__cancel{background:#fff;border:1px solid #ccd0d5;border-radius:100px;padding:12px 20px;font-size:14px;cursor:pointer;margin-left:8px;}
  .fbm__ok{background:#e6f7ed;border:1px solid #2e7d32;color:#1b4d1e;border-radius:10px;padding:14px;margin-bottom:14px;}
  @media(max-width:900px){.fbm{flex-direction:column;}.fbm__side{flex:none;max-width:none;}.fbm__sales{flex-direction:column;}.fbm__salesnav{flex:none;}}
</style>

<div class="fbm">
  <aside class="fbm__side">
    <div class="fbm__brandrow"><h1 class="fbm__brand">Marketplace</h1><span class="fbm__gear">&#9881;</span></div>
    <div class="fbm__search"><input type="search" placeholder="Rechercher sur Marketplace" onkeydown="if(event.key==='Enter'&&this.value){window.location.href='/search?q='+encodeURIComponent(this.value);}"></div>
    <nav class="fbm__nav">
      <button class="fbm__navitem is-active" type="button" data-view="browse" onclick="fbmView('browse',this)"><span class="fbm__ico">&#127978;</span> Tout parcourir</button>
      <a class="fbm__navitem" href="/pages/contact"><span class="fbm__ico">&#128276;</span> Notifications</a>
      <a class="fbm__navitem" href="/pages/contact"><span class="fbm__ico">&#128172;</span> Messagerie</a>
      <a class="fbm__navitem" href="{{ routes.account_url | default: '/account' }}"><span class="fbm__ico">&#128717;</span> Mes achats</a>
      <button class="fbm__navitem" type="button" data-view="sales" onclick="fbmView('sales',this)"><span class="fbm__ico">&#127991;</span> Mes ventes</button>
    </nav>
    <button class="fbm__add" type="button" onclick="fbmOpen()">&#65291; Ajouter un article</button>
    <div class="fbm__block">
      <div class="fbm__blocktitle">Lieu</div>
      <div class="fbm__loc">&#128205; {{ city }} &middot; Dans un rayon de 15 km</div>
    </div>
    <div class="fbm__block">
      <div class="fbm__blocktitle">Cat&eacute;gories</div>
      <ul class="fbm__cats">
        <li><a href="/search?q=v%C3%A9hicules">&#128664; V&eacute;hicules</a></li>
        <li><a href="/search?q=immobilier">&#127968; Location immobili&egrave;re</a></li>
        <li><a href="/collections/high-tech">&#128241; Appareils &eacute;lectroniques</a></li>
        <li><a href="/search?q=r%C3%A9novation">&#128296; Articles de r&eacute;novation int&eacute;rieure</a></li>
        <li><a href="/collections/accessoires-et-materiel-du-sport">&#9917; Articles de sport</a></li>
        <li><a href="/search?q=gratuit">&#127873; Articles gratuits</a></li>
        <li><a href="/collections/maison">&#129681; Articles pour la maison</a></li>
        <li><a href="/search?q=divertissement">&#127916; Divertissement</a></li>
        <li><a href="/collections/bebe-puericulture">&#128106; Famille</a></li>
        <li><a href="/collections/bureautique">&#128188; Fournitures de bureau</a></li>
        <li><a href="/collections/vetements-pour-femme">&#128085; Habillement</a></li>
        <li><a href="/search?q=instruments+de+musique">&#127928; Instruments de musique</a></li>
        <li><a href="/collections/jeux">&#129513; Jeux et jouets</a></li>
        <li><a href="/collections/livres">&#127858; Loisirs</a></li>
        <li><a href="/search?q=annonces">&#128240; Petites annonces</a></li>
        <li><a href="/collections/produits-accessoires-animaux">&#128054; Produits pour animaux</a></li>
        <li><a href="/search?q=immobilier">&#127970; Ventes immobili&egrave;res</a></li>
        <li><a href="/collections/all">&#129309; Groupes d'achat et de vente</a></li>
        <li><a href="/pages/faq">&#8505;&#65039; &Agrave; propos de Marketplace</a></li>
      </ul>
    </div>
  </aside>

  <div class="fbm__main">
    <section class="fbm__view" data-view="browse">
      <div class="fbm__mainhead"><h2>S&eacute;lection du jour</h2><span class="fbm__pin">&#128205; {{ city }}</span></div>
      <div class="fbm__grid">
        {%- for product in mp.products limit: 48 -%}
          <a class="fbm__card" href="{{ product.url }}">
            <span class="fbm__img">{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '180, 360', alt: product.title }}{%- endif -%}</span>
            <span class="fbm__price">{{ product.price | money }}</span>
            <span class="fbm__t">{{ product.title }}</span>
            <span class="fbm__city">{{ city }}</span>
          </a>
        {%- else -%}
          <p>Aucune annonce pour le moment.</p>
        {%- endfor -%}
      </div>
    </section>

    <section class="fbm__view" data-view="sales" style="display:none;">
      <div class="fbm__sales">
        <div class="fbm__salesnav">
          <button class="fbm__add" type="button" onclick="fbmOpen()">&#65291; Ajouter un article</button>
          <nav class="fbm__nav">
            <span class="fbm__navitem is-active"><span class="fbm__ico">&#128202;</span> Tableau de bord de vendeur</span>
            <span class="fbm__navitem"><span class="fbm__ico">&#127991;</span> Vos annonces</span>
            <span class="fbm__navitem"><span class="fbm__ico">&#128226;</span> Annonces</span>
            <span class="fbm__navitem"><span class="fbm__ico">&#128200;</span> Statistiques</span>
            <span class="fbm__navitem"><span class="fbm__ico">&#128100;</span> Profil Marketplace</span>
          </nav>
        </div>
        <div class="fbm__empty">
          <div class="fbm__plane">&#128228;</div>
          <p style="font-weight:700;color:#0F1111;margin:10px 0 4px;">Vos annonces appara&icirc;tront ici d&egrave;s que vous commencerez &agrave; vendre.</p>
          <button class="fbm__add" style="max-width:220px;margin-top:8px;" type="button" onclick="fbmOpen()">&#65291; Ajouter un article</button>
        </div>
      </div>
    </section>
  </div>
</div>

<div class="fbm__modal" id="fbmModal">
  <div class="fbm__dialog fbm">
    <h2>Vendre un article</h2>
    {%- form 'contact', id: 'fbmForm' -%}
      {%- assign fbm_posted = form.posted_successfully? -%}
      {%- assign fbm_err = form.errors -%}
      {%- if form.posted_successfully? -%}
        <div class="fbm__ok">&#9989; Votre annonce a bien &eacute;t&eacute; envoy&eacute;e ! Notre &eacute;quipe la met en ligne rapidement. Pensez &agrave; ajouter vos photos en r&eacute;pondant &agrave; l'e-mail de confirmation.</div>
        <button type="button" class="fbm__cancel" onclick="fbmClose()">Fermer</button>
      {%- else -%}
        <p style="color:#65676b;font-size:13px;margin:0 0 6px;">Remplissez les infos ci-dessous. Votre annonce nous est envoy&eacute;e et mise en ligne rapidement.</p>
        {%- if form.errors -%}<div style="background:#fdecea;border:1px solid #c0392b;color:#922b21;border-radius:8px;padding:10px;margin-bottom:10px;">Merci de v&eacute;rifier les champs : {{ form.errors | default_errors }}</div>{%- endif -%}
        <input type="hidden" name="contact[Type]" value="ANNONCE MARKETPLACE">
        <label>Titre de l'article *</label>
        <input type="text" name="contact[Titre]" required placeholder="Ex. iPhone 15 Pro 256 Go">
        <div class="fbm__rowf">
          <div><label>Prix (&euro;) *</label><input type="text" name="contact[Prix]" required placeholder="450"></div>
          <div><label>&Eacute;tat</label><select name="contact[Etat]"><option>Neuf</option><option>Tr&egrave;s bon &eacute;tat</option><option>Bon &eacute;tat</option><option>Correct</option></select></div>
        </div>
        <div class="fbm__rowf">
          <div><label>Cat&eacute;gorie</label><select name="contact[Categorie]"><option>Appareils &eacute;lectroniques</option><option>V&eacute;hicules</option><option>Articles pour la maison</option><option>Habillement</option><option>Jeux et jouets</option><option>Articles de sport</option><option>Loisirs</option><option>Autres</option></select></div>
          <div><label>Lieu</label><input type="text" name="contact[Lieu]" value="{{ city }}"></div>
        </div>
        <label>Votre e-mail *</label>
        <input type="email" name="contact[email]" required>
        <label>Description</label>
        <textarea name="contact[Description]" rows="4" placeholder="D&eacute;crivez votre article&hellip;"></textarea>
        <p style="color:#65676b;font-size:12px;margin:8px 0 14px;">&#128248; Astuce : envoyez vos photos en r&eacute;pondant &agrave; l'e-mail de confirmation que vous recevrez.</p>
        <div>
          <button type="submit" class="fbm__submit">Publier mon annonce</button>
          <button type="button" class="fbm__cancel" onclick="fbmClose()">Annuler</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

<script>
  function fbmView(v, el){
    document.querySelectorAll('.fbm__view').forEach(function(s){ s.style.display=(s.getAttribute('data-view')===v)?'block':'none'; });
    document.querySelectorAll('.fbm__nav .fbm__navitem[data-view]').forEach(function(b){ b.classList.toggle('is-active', b===el); });
  }
  function fbmOpen(){ document.getElementById('fbmModal').classList.add('is-open'); }
  function fbmClose(){ document.getElementById('fbmModal').classList.remove('is-open'); }
  document.getElementById('fbmModal').addEventListener('click', function(e){ if(e.target===this) fbmClose(); });
  {%- if fbm_posted or fbm_err -%}fbmOpen();{%- endif -%}
</script>

{% schema %}
{
  "name": "Marketplace FB",
  "settings": [],
  "presets": [{ "name": "Marketplace FB" }]
}
{% endschema %}
