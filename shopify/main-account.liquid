{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- style -%}
  .az-acc{max-width:1120px;margin:0 auto;}
  .az-acc__head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px;flex-wrap:wrap;}
  .az-acc__head h1{font-size:28px;margin:0;color:#0F1111;}
  .az-acc__logout{display:inline-flex;align-items:center;gap:6px;color:#007185;text-decoration:none;font-size:14px;}
  .az-acc__logout:hover{color:#C7511F;text-decoration:underline;}
  .az-acc__logout .svg-wrapper{width:18px;height:18px;}
  .az-acc__grid{display:grid;grid-template-columns:1fr;gap:24px;}
  @media screen and (min-width:900px){.az-acc__grid{grid-template-columns:1fr 280px;}}
  .az-acc h2{font-size:20px;margin:0 0 14px;color:#0F1111;}
  .az-acc table.order-history{width:100%;border-collapse:collapse;background:#fff;border:1px solid #D5D9D9;border-radius:8px;overflow:hidden;}
  .az-acc table.order-history thead th{text-transform:uppercase;font-size:11px;letter-spacing:.04em;color:#565959;text-align:left;padding:14px 16px;border-bottom:1px solid #E3E6E6;font-weight:700;}
  .az-acc table.order-history thead th#ColumnTotal{text-align:right;}
  .az-acc table.order-history tbody td{padding:16px;border-bottom:1px solid #EAEDED;font-size:14px;color:#0F1111;vertical-align:middle;}
  .az-acc table.order-history tbody tr:last-child td{border-bottom:none;}
  .az-acc table.order-history tbody tr:nth-child(even){background:#FBFBFB;}
  .az-acc .az-ordno{display:inline-block;border:1px solid #D5D9D9;border-radius:6px;padding:8px 12px;color:#007185;text-decoration:none;font-weight:500;background:#fff;white-space:nowrap;}
  .az-acc .az-ordno:hover{border-color:#FFA41C;color:#C7511F;}
  .az-acc .az-thumbs{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px;align-items:center;}
  .az-acc .az-thumbs img{width:44px;height:44px;object-fit:cover;border:1px solid #E3E6E6;border-radius:6px;background:#fff;}
  .az-acc .az-thumbs .az-more{font-size:12px;color:#565959;background:#EAEDED;border-radius:6px;padding:0 8px;height:44px;display:inline-flex;align-items:center;}
  .az-acc td[headers~="ColumnTotal"]{text-align:right;font-weight:700;white-space:nowrap;}
  .az-acc__side{background:#fff;border:1px solid #D5D9D9;border-radius:8px;padding:18px;height:fit-content;}
  .az-acc__side h2{font-size:18px;}
  .az-acc__side address{font-style:normal;line-height:1.7;color:#0F1111;font-size:14px;}
  .az-acc__side a{color:#007185;text-decoration:none;font-size:14px;display:inline-block;margin-top:12px;}
  .az-acc__side a:hover{color:#C7511F;text-decoration:underline;}
  .az-acc .pagination{margin-top:18px;}
{%- endstyle -%}

<div class="customer account az-acc section-{{ section.id }}-padding">
  <div class="az-acc__head">
    <h1>{{ 'customer.account.title' | t }}</h1>
    <a class="az-acc__logout" href="{{ routes.account_logout_url }}">
      <span class="svg-wrapper">
        {{- 'icon-account.svg' | inline_asset_content -}}
      </span>
      {{ 'customer.log_out' | t }}
    </a>
  </div>

  <div class="az-acc__grid">
    <div>
      <h2>{{ 'customer.orders.title' | t }}</h2>

      {% paginate customer.orders by 20 %}
        {%- if customer.orders.size > 0 -%}
          <table role="table" class="order-history">
            <caption class="visually-hidden">{{ 'customer.orders.title' | t }}</caption>
            <thead role="rowgroup">
              <tr role="row">
                <th id="ColumnOrder" scope="col" role="columnheader">{{ 'customer.orders.order_number' | t }}</th>
                <th id="ColumnDate" scope="col" role="columnheader">{{ 'customer.orders.date' | t }}</th>
                <th id="ColumnPayment" scope="col" role="columnheader">{{ 'customer.orders.payment_status' | t }}</th>
                <th id="ColumnFulfillment" scope="col" role="columnheader">{{ 'customer.orders.fulfillment_status' | t }}</th>
                <th id="ColumnTotal" scope="col" role="columnheader">{{ 'customer.orders.total' | t }}</th>
              </tr>
            </thead>
            <tbody role="rowgroup">
              {%- for order in customer.orders -%}
                <tr role="row">
                  <td id="RowOrder" role="cell" headers="ColumnOrder" data-label="{{ 'customer.orders.order_number' | t }}">
                    <a class="az-ordno" href="{{ order.customer_url }}" aria-label="{{ 'customer.orders.order_number_link' | t: number: order.name }}">
                      {{ order.name }}
                    </a>
                    {%- if order.line_items.size > 0 -%}
                      <div class="az-thumbs">
                        {%- for line in order.line_items limit: 4 -%}
                          {%- if line.image -%}
                            <a href="{{ order.customer_url }}">
                              <img src="{{ line.image | image_url: width: 88, height: 88, crop: 'center' }}" alt="{{ line.title | escape }}" width="44" height="44" loading="lazy">
                            </a>
                          {%- endif -%}
                        {%- endfor -%}
                        {%- if order.line_items.size > 4 -%}
                          <span class="az-more">+{{ order.line_items.size | minus: 4 }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </td>
                  <td headers="RowOrder ColumnDate" role="cell" data-label="{{ 'customer.orders.date' | t }}">
                    {{ order.created_at | time_tag: format: 'date' }}
                  </td>
                  <td headers="RowOrder ColumnPayment" role="cell" data-label="{{ 'customer.orders.payment_status' | t }}">
                    {{ order.financial_status_label }}
                  </td>
                  <td headers="RowOrder ColumnFulfillment" role="cell" data-label="{{ 'customer.orders.fulfillment_status' | t }}">
                    {{ order.fulfillment_status_label }}
                  </td>
                  <td headers="RowOrder ColumnTotal" role="cell" data-label="{{ 'customer.orders.total' | t }}">
                    {{ order.total_net_amount | money_with_currency }}
                  </td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- else -%}
          <p>{{ 'customer.orders.none' | t }}</p>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          {%- if paginate.parts.size > 0 -%}
            <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
              <ul role="list">
                {%- if paginate.previous -%}
                  <li>
                    <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
                      <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                    </a>
                  </li>
                {%- endif -%}
                {%- for part in paginate.parts -%}
                  <li>
                    {%- if part.is_link -%}
                      <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{- part.title -}}</a>
                    {%- else -%}
                      {%- if part.title == paginate.current_page -%}
                        <span aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{- part.title -}}</span>
                      {%- else -%}
                        <span>{{ part.title }}</span>
                      {%- endif -%}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
                {%- if paginate.next -%}
                  <li>
                    <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
                      <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            </nav>
          {%- endif -%}
        {%- endif -%}
      {% endpaginate %}
    </div>

    <aside class="az-acc__side">
      <h2>{{ 'customer.account.details' | t }}</h2>
      {{ customer.default_address | format_address }}
      <a href="{{ routes.account_addresses_url }}">
        {{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})
      </a>
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-account.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
