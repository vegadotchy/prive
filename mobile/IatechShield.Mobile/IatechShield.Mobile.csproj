<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>IatechShield.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Évite l'erreur NETSDK1202 si le runner utilise un SDK plus récent. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>

    <ApplicationTitle>IATECH-SHIELD PRO</ApplicationTitle>
    <ApplicationId>be.iatechfutur.shield</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icône & écran de démarrage (couleurs IATECH). -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#06101B" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#06101B" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>

</Project>
