<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IatechShield</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDK officiel Anthropic (assistant IA). -->
    <PackageReference Include="Anthropic" Version="*" />
    <!-- Accès au registre Windows (points de démarrage automatique). -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <!-- Chiffrement DPAPI (stockage local des identifiants VPN). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- La base de signatures est copiée chez tout projet qui référence le moteur. -->
    <None Update="signatures.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Clé publique de licence : embarquée dans l'assembly (lue par LicenseVerifier). -->
    <EmbeddedResource Include="Licensing\public_key.pem" />
  </ItemGroup>

</Project>
