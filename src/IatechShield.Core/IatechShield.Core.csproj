<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IatechShield</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- La base de signatures est copiée chez tout projet qui référence le moteur. -->
    <None Update="signatures.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Clé publique de licence : embarquée dans l'assembly (lue par LicenseVerifier). -->
    <EmbeddedResource Include="Licensing\public_key.pem" />
  </ItemGroup>

</Project>
