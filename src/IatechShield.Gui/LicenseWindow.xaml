<Window x:Class="IatechShield.Gui.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activation — IATECH-SHIELD PRO" Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI">

    <Border CornerRadius="16" Background="{StaticResource WindowBackground}"
            BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="1">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titre -->
            <Grid Grid.Row="0" MouseLeftButtonDown="OnDrag" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Activer " FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="IATECH-SHIELD PRO" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
                <Button Content="&#xE711;" Click="OnClose" Style="{x:Null}" HorizontalAlignment="Right"
                        FontFamily="Segoe MDL2 Assets" FontSize="11" Width="30" Height="26"
                        Foreground="{StaticResource TextMutedBrush}" Background="Transparent"
                        BorderThickness="0" Cursor="Hand"/>
            </Grid>

            <TextBlock x:Name="TrialInfoText" Grid.Row="1" Margin="0,10,0,0"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>

            <!-- Formules tarifaires -->
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0"
                        Tag="monthly" Cursor="Hand" MouseLeftButtonUp="OnBuyPlan"
                        ToolTip="Acheter l'abonnement mensuel sur iatechfutur.be">
                    <StackPanel>
                        <TextBlock Text="Mensuel" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="5 €" Foreground="{StaticResource AccentBrush}" FontSize="26"
                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock Text="par mois" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="Acheter →" Foreground="{StaticResource GoldBrush}"
                                   FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,6,0"
                        Tag="yearly" Cursor="Hand" MouseLeftButtonUp="OnBuyPlan"
                        ToolTip="Acheter l'abonnement annuel sur iatechfutur.be">
                    <StackPanel>
                        <TextBlock Text="Annuel" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="50 €" Foreground="{StaticResource AccentBrush}" FontSize="26"
                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock Text="par an" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="2 mois offerts" Foreground="{StaticResource GreenBrush}"
                                   FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock Text="Acheter →" Foreground="{StaticResource GoldBrush}"
                                   FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,0,0"
                        BorderBrush="{StaticResource AccentBrush}"
                        Tag="lifetime" Cursor="Hand" MouseLeftButtonUp="OnBuyPlan"
                        ToolTip="Acheter la licence à vie sur iatechfutur.be">
                    <StackPanel>
                        <TextBlock Text="À vie" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="249,99 €" Foreground="{StaticResource AccentBrush}" FontSize="22"
                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock Text="paiement unique" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="Acheter →" Foreground="{StaticResource GoldBrush}"
                                   FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Saisie de la clé -->
            <StackPanel Grid.Row="4" Margin="0,18,0,0">
                <TextBlock Text="Saisissez votre clé de licence :" Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="12" Margin="0,0,0,6"/>
                <TextBox x:Name="KeyInput" FontFamily="Consolas" FontSize="12" Height="60"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8"/>
                <TextBlock x:Name="ResultText" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="ACTIVER LA LICENCE" Style="{StaticResource PrimaryButton}"
                            Click="OnActivate"/>
                    <Button x:Name="OnlineActivateButton" Grid.Column="1" Content="Activer en ligne"
                            Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="OnActivateOnline"/>
                </Grid>
            </StackPanel>

            <!-- ============ ÉCRAN DE SUCCÈS (après activation réussie) ============ -->
            <Border x:Name="SuccessPanel" Grid.Row="0" Grid.RowSpan="5"
                    Margin="-26" CornerRadius="16" Visibility="Collapsed"
                    Background="{StaticResource WindowBackground}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                    <!-- Logo bouclier + pastille verte avec coche -->
                    <Grid Width="120" Height="120" HorizontalAlignment="Center">
                        <Ellipse Width="120" Height="120" Fill="#0E2E1F"/>
                        <Ellipse Width="120" Height="120" Stroke="{StaticResource GreenBrush}" StrokeThickness="2"/>
                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="54"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource GreenBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="Félicitations !" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,22,0,0"/>
                    <TextBlock x:Name="SuccessMessage" FontSize="15"
                               Foreground="{StaticResource GreenBrush}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SuccessDetail" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"
                               TextAlignment="Center" TextWrapping="Wrap"/>

                    <Button Content="Continuer" Style="{StaticResource PrimaryButton}"
                            Click="OnSuccessContinue" Margin="0,28,0,0" MinWidth="200"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
