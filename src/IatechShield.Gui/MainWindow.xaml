<Window x:Class="IatechShield.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IATECH-SHIELD PRO" Height="820" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" MinWidth="1080" MinHeight="720"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        Icon="/icon.ico"
        ShowInTaskbar="True">

    <Border CornerRadius="16" Background="{StaticResource WindowBackground}"
            BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======================= BARRE LATÉRALE ======================= -->
            <Border Grid.Column="0" Background="#0A1726" CornerRadius="16,0,0,16">
                <DockPanel Margin="0,18">
                    <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="IATECH" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock Text="SHIELD" Foreground="{StaticResource AccentBrush}"
                                   FontSize="9" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE80F;" IsChecked="True" Content="Dashboard" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE72E;" Content="Protection" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE721;" Content="Scan" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE83D;" Content="Firewall" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE72E;" Content="Outils" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE968;" Content="Réseau" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE9D9;" Content="Radar" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE8CE;" Content="VPN" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE72E;" Content="Coffre-fort" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xEA18;" Content="Centre" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE9D2;" Content="Intégrité" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE8EC;" Content="Jumeau" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE9F9;" Content="Investigation" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE99A;" Content="Copilote" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE950;" Content="Appareil" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE77B;" Content="Système" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE713;" Content="Settings" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE7C3;" Content="Logs" Checked="OnNav"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- =========================== CONTENU =========================== -->
            <Grid Grid.Column="1" Margin="22,16,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- En-tête -->
                <Grid Grid.Row="0" MouseLeftButtonDown="OnHeaderDrag" Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="IATECH-SHIELD " FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="PRO" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="0.1" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom" Margin="6,0,0,3"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="LicenseBadge" Background="#0E2A3F" CornerRadius="8" Padding="10,4"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="LicenseStatusText" Text="Essai" FontSize="11"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <Button x:Name="AiButton" Content="Assistant IA" Click="OnAiAssistant" Style="{x:Null}"
                                FontSize="11" Height="26" Padding="10,0" Cursor="Hand" Margin="0,0,8,0"
                                Foreground="White" Background="#16607A" BorderThickness="0"/>
                        <Button x:Name="ActivateButton" Content="Activer" Click="OnOpenLicense" Style="{x:Null}"
                                FontSize="11" Height="26" Padding="10,0" Cursor="Hand" Margin="0,0,8,0"
                                Foreground="White" Background="#1577C9" BorderThickness="0"/>
                        <Button Content="&#xE738;" Click="OnMinimize" Style="{x:Null}"
                                FontFamily="Segoe MDL2 Assets" FontSize="11" Width="30" Height="26"
                                Foreground="{StaticResource TextMutedBrush}" Background="Transparent"
                                BorderThickness="0" Cursor="Hand"/>
                        <Button Content="&#xE711;" Click="OnClose" Style="{x:Null}"
                                FontFamily="Segoe MDL2 Assets" FontSize="11" Width="30" Height="26"
                                Foreground="{StaticResource TextMutedBrush}" Background="Transparent"
                                BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- ========================= PAGES ========================= -->
                <Grid Grid.Row="1" Margin="0,12,0,0">

                    <!-- Bande d'accent colorée par onglet (animée) -->
                    <Border x:Name="AccentStrip" Height="3" VerticalAlignment="Top" CornerRadius="2"
                            Background="{StaticResource AccentBrush}" Panel.ZIndex="10"
                            HorizontalAlignment="Stretch" Margin="0,-9,0,0"/>

                    <!-- ================= PAGE : DASHBOARD ================= -->
                    <Grid x:Name="PageDashboard">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="290"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="300" Height="300" Stroke="#143247" StrokeThickness="1"/>
                                    <Ellipse x:Name="RingOuter" Width="270" Height="270" Stroke="{StaticResource AccentDimBrush}"
                                             StrokeThickness="1.5" StrokeDashArray="2 6" Opacity="0.7">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="RingRotate" CenterX="135" CenterY="135"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="MainRing" Width="220" Height="220" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Opacity="0.85">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="MainRingGlow" Color="#22D3E8" BlurRadius="25" ShadowDepth="0" Opacity="0.7"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Grid Width="150" Height="150">
                                        <Ellipse x:Name="CoreGlow" Width="150" Height="150" Fill="#1422D3E8"/>
                                        <Path x:Name="HeartPath" Data="M75,128 C40,100 18,78 18,52 C18,33 33,20 50,20 C61,20 70,26 75,36 C80,26 89,20 100,20 C117,20 132,33 132,52 C132,78 110,100 75,128 Z"
                                              Stretch="Uniform" Width="86" Height="86"
                                              Fill="#11314A" Stroke="{StaticResource AccentBrush}" StrokeThickness="2">
                                            <Path.Effect>
                                                <DropShadowEffect x:Name="HeartGlow" Color="#22D3E8" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/>
                                            </Path.Effect>
                                        </Path>
                                        <Ellipse x:Name="CoreDot" Width="26" Height="26" Fill="{StaticResource AccentBrush}">
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="CoreDotGlow" Color="#22D3E8" BlurRadius="30" ShadowDepth="0" Opacity="1"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Grid>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,0"
                                            Background="#0E2A3F" CornerRadius="8" Padding="10,6"
                                            BorderBrush="{StaticResource GreenBrush}" BorderThickness="1">
                                        <TextBlock x:Name="ShieldStatusText" Text="PROTÉGÉ" Foreground="{StaticResource GreenBrush}"
                                                   FontWeight="Bold" FontSize="13"/>
                                    </Border>
                                </Grid>
                            </Grid>

                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Activité du Système" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <Polyline Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" Margin="0,12,0,0"
                                                  Points="0,30 15,22 30,34 45,12 60,26 75,8 90,28 105,18 120,32 135,14 150,24 165,10 180,26 195,20 210,30"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Updates information" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock x:Name="UpdatesDateText" Text="Base de données à jour"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="SignatureCountText" Text="" Foreground="{StaticResource AccentBrush}"
                                                   FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Analyse rapide" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="ScanStatusText" Text="Prêt à analyser." Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar x:Name="ScanProgress" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                                 Visibility="Collapsed" Foreground="{StaticResource AccentBrush}"
                                                 Background="#1A2740" BorderThickness="0"/>
                                    <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                                            Click="OnQuickScan">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="LANCER L'ANALYSE RAPIDE" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Menaces Détectées" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ThreatCountText" Text="0" Foreground="{StaticResource GreenBrush}"
                                               FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="ThreatStatusText" Text="SÉCURISÉ" Foreground="{StaticResource GreenBrush}"
                                               FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ReactorPulseText" Text="Pulsations du cœur-réacteur : STABLES"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                                               HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ================= PAGE : PROTECTION ================= -->
                    <Grid x:Name="PageProtection" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Protection En Direct" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Activez les boucliers de protection en temps réel."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Protection en Temps Réel" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="Analyse les fichiers à leur création/modification." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="RealtimeSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="False" Checked="OnRealtimeToggled" Unchecked="OnRealtimeToggled"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,8"/>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Bouclier Anti-Ransomware" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="Canaris + arrêt du processus chiffrant (Documents, Images, Bureau)." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="RansomwareSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="False" Checked="OnRansomwareToggled" Unchecked="OnRansomwareToggled"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,8"/>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Démarrer avec Windows" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="Inscrit IATECH-SHIELD au démarrage (registre)." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="AutostartSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="False" Checked="OnAutostartToggled" Unchecked="OnAutostartToggled"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ==================== PAGE : SCAN ==================== -->
                    <Grid x:Name="PageScan" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Options de scan -->
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Analyser" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Choisissez ce qui doit être analysé :" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" Margin="0,0,0,10"/>

                                <CheckBox x:Name="ChkHardDrives" Style="{StaticResource Check}" Content="Disques durs (fixes)"/>
                                <CheckBox x:Name="ChkRemovable"  Style="{StaticResource Check}" Content="Disques amovibles (clés USB)"/>
                                <CheckBox x:Name="ChkAllFiles"   Style="{StaticResource Check}" Content="Tous les fichiers (analyse complète)"/>
                                <CheckBox x:Name="ChkFolder"     Style="{StaticResource Check}" Content="Dossier spécifique…"/>
                                <CheckBox x:Name="ChkFile"       Style="{StaticResource Check}" Content="Fichier spécifique…"/>
                                <CheckBox x:Name="ChkMail"       Style="{StaticResource Check}" Content="Courriels (Outlook / Thunderbird)"/>
                                <CheckBox x:Name="ChkStartup"    Style="{StaticResource Check}" Content="Mémoire et démarrage"/>

                                <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,12"/>

                                <TextBlock Text="Après le scan complet :" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="12" Margin="0,0,0,6"/>
                                <RadioButton x:Name="PostNone" GroupName="post" Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="12" Margin="0,3" IsChecked="True" Content="Ne rien faire"/>
                                <RadioButton x:Name="PostShutdown" GroupName="post" Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="12" Margin="0,3" Content="Éteindre l'ordinateur"/>
                                <RadioButton x:Name="PostRestart" GroupName="post" Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="12" Margin="0,3" Content="Redémarrer l'ordinateur"/>

                                <Button x:Name="FullScanButton" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                                        Click="OnFullScan" Content="LANCER L'ANALYSE"/>
                            </StackPanel>
                        </Border>

                        <!-- Résultats -->
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Résultats de l'analyse" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold" FontSize="14"/>
                                <StackPanel Grid.Row="1">
                                    <TextBlock x:Name="FullScanStatus" Text="En attente…" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="FullScanProgress" Height="6" Margin="0,8,0,8" Minimum="0" Maximum="100"
                                                 Visibility="Collapsed" Foreground="{StaticResource AccentBrush}"
                                                 Background="#1A2740" BorderThickness="0"/>
                                </StackPanel>
                                <ListBox Grid.Row="2" x:Name="ScanResultsList" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#26FFFFFF" CornerRadius="8" Padding="12" Margin="0,4"
                                                    BorderBrush="#3344E0FF" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="190"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="#FF6B6B"
                                                                   FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="{Binding Path}" Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                                                              SelectedValuePath="Content"
                                                              SelectedValue="{Binding SelectedAction, Mode=TwoWay}">
                                                        <ComboBoxItem Content="Mettre en quarantaine"/>
                                                        <ComboBoxItem Content="Supprimer"/>
                                                        <ComboBoxItem Content="Analyser"/>
                                                        <ComboBoxItem Content="Ignorer"/>
                                                    </ComboBox>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Expliquer (IA)" Style="{StaticResource GhostButton}"
                                                                Click="OnExplainThreat" Tag="{Binding}" Margin="0,0,6,0"/>
                                                        <Button Content="Appliquer" Style="{StaticResource GhostButton}"
                                                                Click="OnApplyThreatAction"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================== PAGE : FIREWALL ================== -->
                    <Grid x:Name="PageFirewall" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Pare-feu et protection du réseau" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Personnes et systèmes pouvant accéder à vos réseaux."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14"/>

                            <!-- Profils du pare-feu -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Profils du pare-feu Windows" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <Button x:Name="FwRefreshButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                                Content="Rafraîchir l'état" Click="OnFwRefresh"/>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Réseau avec domaine" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                            <TextBlock x:Name="FwDomainStatus" Text="—" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Activer" Tag="Domain True" Style="{StaticResource GhostButton}" Height="30" Click="OnFwAction" Margin="0,0,8,0"/>
                                            <Button Content="Désactiver" Tag="Domain False" Style="{StaticResource GhostButton}" Height="30" Click="OnFwAction"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Réseau privé" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                            <TextBlock x:Name="FwPrivateStatus" Text="—" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Activer" Tag="Private True" Style="{StaticResource GhostButton}" Height="30" Click="OnFwAction" Margin="0,0,8,0"/>
                                            <Button Content="Désactiver" Tag="Private False" Style="{StaticResource GhostButton}" Height="30" Click="OnFwAction"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Réseau public" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                            <TextBlock x:Name="FwPublicStatus" Text="—" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Activer" Tag="Public True" Style="{StaticResource GhostButton}" Height="30" Click="OnFwAction" Margin="0,0,8,0"/>
                                            <Button Content="Désactiver" Tag="Public False" Style="{StaticResource GhostButton}" Height="30" Click="OnFwAction"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Pare-feu Windows" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock x:Name="FirewallStateText" Text="État inconnu" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <Button x:Name="FirewallOpenButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                                Content="Ouvrir le pare-feu Windows" Click="OnOpenFirewall"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,10"/>
                                    <TextBlock Text="Connexions sortantes actives" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                                    <Button x:Name="ListConnButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                            Content="Lister les connexions" Click="OnListConnections"/>
                                    <ListBox x:Name="ConnectionsList" Background="#0A1726" BorderThickness="0" Height="220"
                                             Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ================== PAGE : SETTINGS ================== -->
                    <Grid x:Name="PageSettings" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Paramètres" Style="{StaticResource PageTitle}"/>
                            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Assistant IA (Claude)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="ApiKeyStatusText" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Adresse e-mail (pour l'envoi des journaux)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox x:Name="EmailInput" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,8,0,0" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <!-- Options avancées -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Options de protection" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>

                                    <Grid Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Mode silencieux" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                            <TextBlock Text="Désactive les effets sonores." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="SilentSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="False" Checked="OnSilentToggled" Unchecked="OnSilentToggled"/>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,12"/>

                                    <TextBlock Text="Analyse planifiée" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                    <TextBlock Text="Lance automatiquement une analyse rapide à intervalle régulier." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="ScheduleCombo" Width="260" HorizontalAlignment="Left"
                                              SelectedValuePath="Content" SelectionChanged="OnScheduleChanged">
                                        <ComboBoxItem Content="Désactivée" IsSelected="True"/>
                                        <ComboBoxItem Content="Toutes les heures"/>
                                        <ComboBoxItem Content="Toutes les 6 heures"/>
                                        <ComboBoxItem Content="Une fois par jour"/>
                                    </ComboBox>

                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,12"/>

                                    <TextBlock Text="Mise à jour des signatures" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                    <TextBlock Text="Télécharge une base de signatures depuis une URL (signatures.json)." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="UpdateUrlInput" Grid.Column="0" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" FontSize="12" VerticalContentAlignment="Center"/>
                                        <Button x:Name="UpdateSigButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                                Content="Mettre à jour" Click="OnUpdateSignatures" Margin="10,0,0,0"/>
                                    </Grid>
                                    <TextBlock x:Name="UpdateStatus" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Mise à jour de l'application -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Mise à jour de l'application" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="AppVersionText" Text="Version installée : —" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CheckUpdateButton" Style="{StaticResource GhostButton}"
                                                Content="Rechercher une mise à jour" Click="OnCheckUpdate"/>
                                        <Button x:Name="InstallUpdateButton" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                                Content="Télécharger et installer" Click="OnInstallUpdate" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AppUpdateStatus" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="AppUpdateProgress" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                                 Visibility="Collapsed" Foreground="{StaticResource AccentBrush}"
                                                 Background="#1A2740" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <!-- Réputation VirusTotal -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Réputation VirusTotal" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Vérifie un fichier via son hash SHA-256 sur 70+ antivirus (le fichier n'est pas envoyé)." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="VtApiKeyInput" Grid.Column="0" Background="#0A1726"
                                                     BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" FontSize="12" VerticalContentAlignment="Center"/>
                                        <Button x:Name="VtCheckFileButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                                Content="Vérifier un fichier" Click="OnVirusTotalCheck" Margin="10,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="Clé API VirusTotal (gratuite sur virustotal.com) — ou définissez VIRUSTOTAL_API_KEY." Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="VtStatus" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Protection anti-altération -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Protection par mot de passe (anti-altération)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Exige un mot de passe pour quitter l'application ou désactiver la protection en temps réel." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="TamperPwdInput" Grid.Column="0" Background="#0A1726"
                                                     BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" FontSize="12" VerticalContentAlignment="Center"/>
                                        <Button x:Name="TamperSetButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                                Content="Définir" Click="OnSetTamperPassword" Margin="10,0,0,0"/>
                                        <Button x:Name="TamperClearButton" Grid.Column="2" Style="{StaticResource GhostButton}"
                                                Content="Retirer" Click="OnClearTamperPassword" Margin="8,0,0,0"/>
                                    </Grid>
                                    <TextBlock x:Name="TamperStatus" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Verrou de session (écran de veille + PIN) -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Verrou de session (écran logo + PIN)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Après une période d'inactivité, affiche un écran plein écran au logo IATECH-SHIELD, déverrouillé par un code PIN. (Confidentialité visuelle, pas un verrou Windows.)" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="LockPinInput" Grid.Column="0" Background="#0A1726"
                                                     BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" FontSize="12" VerticalContentAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBox x:Name="LockDelayInput" Text="5" Width="44" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                     BorderBrush="{StaticResource PanelStrokeBrush}" Padding="6,4" VerticalContentAlignment="Center" TextAlignment="Center"/>
                                            <TextBlock Text="min" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="LockEnableButton" Grid.Column="2" Style="{StaticResource GhostButton}"
                                                Content="Activer" Click="OnEnableLock" Margin="10,0,0,0"/>
                                        <Button x:Name="LockDisableButton" Grid.Column="3" Style="{StaticResource GhostButton}"
                                                Content="Désactiver" Click="OnDisableLock" Margin="8,0,0,0"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="LockNowButton" Style="{StaticResource GhostButton}" Content="Verrouiller maintenant" Click="OnLockNow"/>
                                        <TextBlock x:Name="LockStatus" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Gestionnaire de quarantaine -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Gestionnaire de quarantaine" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <ListBox x:Name="QuarantineList" Background="#0A1726" BorderThickness="0" Height="140"
                                             Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,8,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="RefreshQuarantineButton" Style="{StaticResource GhostButton}"
                                                Content="Actualiser" Click="OnRefreshQuarantine" Margin="0,0,10,0"/>
                                        <Button x:Name="RestoreQuarantineButton" Style="{StaticResource GhostButton}"
                                                Content="Restaurer la sélection" Click="OnRestoreQuarantine" Margin="0,0,10,0"/>
                                        <Button x:Name="DeleteQuarantineButton" Style="{StaticResource GhostButton}"
                                                Content="Supprimer la sélection" Click="OnDeleteQuarantine"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Quarantaine &amp; licence" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="OpenQuarantineButton" Style="{StaticResource GhostButton}"
                                                Content="Ouvrir le dossier de quarantaine" Click="OnOpenQuarantine" Margin="0,0,10,0"/>
                                        <Button x:Name="DeactivateButton" Style="{StaticResource GhostButton}"
                                                Content="Désactiver la licence" Click="OnDeactivateLicense"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ==================== PAGE : LOGS ==================== -->
                    <Grid x:Name="PageLogs" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Journal d'activité" Style="{StaticResource PageTitle}"/>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,8">
                            <TextBox x:Name="LogBox" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="0" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                        </Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button x:Name="SendLogMailButton" Style="{StaticResource GhostButton}"
                                    Content="Envoyer par e-mail" Click="OnSendLogMail" Margin="0,0,10,0"/>
                            <Button x:Name="SaveLogButton" Style="{StaticResource GhostButton}"
                                    Content="Enregistrer le journal" Click="OnSaveLog" Margin="0,0,10,0"/>
                            <Button x:Name="ClearLogButton" Style="{StaticResource GhostButton}"
                                    Content="Effacer" Click="OnClearLog"/>
                        </StackPanel>
                    </Grid>

                    <!-- ==================== PAGE : OUTILS ==================== -->
                    <Grid x:Name="PageTools" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Outils de protection" Style="{StaticResource PageTitle}"/>

                                <!-- Chiffrement de dossier -->
                                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🔒 Chiffrer un dossier (mot de passe)" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="AES-256. Produit un fichier .iasx protégé par mot de passe."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,8"/>
                                        <PasswordBox x:Name="CryptoPassword" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                     BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" FontSize="12"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="EncryptButton" Style="{StaticResource GhostButton}"
                                                    Content="Chiffrer un dossier…" Click="OnEncryptFolder" Margin="0,0,10,0"/>
                                            <Button x:Name="DecryptButton" Style="{StaticResource GhostButton}"
                                                    Content="Déchiffrer un .iasx…" Click="OnDecryptFolder"/>
                                        </StackPanel>
                                        <TextBlock x:Name="CryptoStatus" Text="" Foreground="{StaticResource AccentBrush}"
                                                   FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Clé USB protégée -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🔑 Protéger une clé USB" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Chiffre un dossier de la clé USB avec le mot de passe ci-dessus."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,8"/>
                                        <Button x:Name="UsbProtectButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                Content="Choisir un dossier sur la clé à protéger…" Click="OnProtectUsb"/>
                                    </StackPanel>
                                </Border>

                                <!-- Vérification d'URL -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🌐 Vérifier une URL / un site" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Indique si le lien est fiable, à surveiller ou dangereux (phishing, typosquatting…)."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="UrlInput" Grid.Column="0" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                     BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" FontSize="12"
                                                     VerticalContentAlignment="Center"/>
                                            <Button x:Name="CheckUrlButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                                    Content="Analyser" Click="OnCheckUrl" Margin="10,0,0,0"/>
                                        </Grid>
                                        <TextBlock x:Name="UrlVerdictText" Text="" FontSize="13" FontWeight="Bold" Margin="0,10,0,0"/>
                                        <TextBlock x:Name="UrlReasonsText" Text="" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Verrouillage PC -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🖥️ Verrouillage du PC" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Verrouille la session (mot de passe Windows requis pour rouvrir)."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="SessionLockButton" Style="{StaticResource GhostButton}"
                                                    Content="Verrouiller maintenant" Click="OnSessionLockNow" Margin="0,0,10,0"/>
                                        </StackPanel>
                                        <Grid Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Exiger le mot de passe à la sortie de veille" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                            </StackPanel>
                                            <ToggleButton x:Name="WakePasswordSwitch" Style="{StaticResource Switch}"
                                                          HorizontalAlignment="Right" IsChecked="False"
                                                          Checked="OnWakePasswordToggled" Unchecked="OnWakePasswordToggled"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ==================== PAGE : RÉSEAU =================== -->
                    <Grid x:Name="PageNetwork" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Analyse du réseau" Style="{StaticResource PageTitle}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                            <Button x:Name="NetScanButton" Style="{StaticResource PrimaryButton}"
                                    Content="ANALYSER LE RÉSEAU" Click="OnNetworkScan" Width="220"/>
                            <TextBlock x:Name="NetStatus" Text="Détecte PC, imprimantes et appareils connectés."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="4,0,4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Adresse IP" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="Nom (modifiable)" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="Adresse MAC" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                                </Grid>
                                <ListBox Grid.Row="1" x:Name="NetworkList" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#22FFFFFF" CornerRadius="8" Padding="10" Margin="0,3"
                                                    BorderBrush="#3344E0FF" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Ip}" VerticalAlignment="Center"
                                                               Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"/>
                                                    <TextBox Grid.Column="1" Text="{Binding CustomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Margin="6,0" VerticalContentAlignment="Center"
                                                             Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                             BorderBrush="{StaticResource PanelStrokeBrush}" Padding="6,4"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Mac}" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="11"/>
                                                    <Button Grid.Column="3" Content="Renommer" Style="{StaticResource GhostButton}"
                                                            Height="30" Click="OnRenameDevice" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- =================== PAGE : SYSTÈME =================== -->
                    <Grid x:Name="PageSystem" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Compte, famille &amp; performances" Style="{StaticResource PageTitle}"/>

                                <!-- Protection du compte -->
                                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="👤 Protection du compte" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock x:Name="AccountUserText" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource GhostButton}" Content="Options de connexion (Windows Hello)"
                                                    Tag="ms-settings:signinoptions" Click="OnOpenSetting" Margin="0,0,10,0"/>
                                            <Button Style="{StaticResource GhostButton}" Content="Verrouillage dynamique"
                                                    Tag="ms-settings:lockscreen" Click="OnOpenSetting"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Contrôle parental -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="👪 Contrôle parental" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Temps d'écran, filtrage de contenu et rapports d'activité (Microsoft Family)."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,8"/>
                                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                Content="Ouvrir le contrôle parental" Tag="https://family.microsoft.com" Click="OnOpenSetting"/>
                                    </StackPanel>
                                </Border>

                                <!-- Performances & intégrité -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="💚 Performances &amp; intégrité" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock x:Name="PerfDiskText" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,2"/>
                                        <TextBlock x:Name="PerfRamText" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource GhostButton}" Content="Windows Update"
                                                    Tag="ms-settings:windowsupdate" Click="OnOpenSetting" Margin="0,0,10,0"/>
                                            <Button x:Name="PerfRefreshButton" Style="{StaticResource GhostButton}"
                                                    Content="Actualiser" Click="OnRefreshPerf"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- =============== PAGE : RADAR RÉSEAU =============== -->
                    <Grid x:Name="PageRadar" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Radar du réseau local" Style="{StaticResource PageTitle}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                            <Button x:Name="RadarButton" Style="{StaticResource PrimaryButton}" Width="200"
                                    Content="LANCER LE RADAR" Click="OnRadarScan"/>
                            <TextBlock x:Name="RadarStatus" Text="Détecte appareils, ports ouverts, caméras IP, NAS et objets connectés vulnérables."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <ListBox x:Name="RadarList" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#22FFFFFF" CornerRadius="8" Padding="12" Margin="0,3"
                                                BorderBrush="{Binding BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Ip}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Mac}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,1,0,0"/>
                                                    <Border Background="#F59E0B" CornerRadius="4" Padding="5,1" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                            Visibility="{Binding NewVisibility}">
                                                        <TextBlock Text="NOUVEAU" Foreground="#0A1726" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding NameLine}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding PortsLine}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                    <ItemsControl ItemsSource="{Binding Risks}" Margin="0,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" Foreground="#FF6B6B" FontSize="10" TextWrapping="Wrap" Margin="0,1"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- ===================== PAGE : VPN ==================== -->
                    <Grid x:Name="PageVpn" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="VPN" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Connexion sécurisée via le serveur VPN de votre NAS Synology (ou tout serveur L2TP/IPSec, SSTP ou PPTP). Utilise le client VPN intégré à Windows."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,10"/>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <!-- Profils enregistrés -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Profil VPN (sélectionner ou nommer pour enregistrer)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                <ComboBox x:Name="VpnProfileBox" IsEditable="True" Margin="0,3,0,0"
                                                          SelectionChanged="OnVpnProfileSelected"/>
                                            </StackPanel>
                                            <Button x:Name="VpnSaveProfileButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                                    Content="Enregistrer" Click="OnVpnSaveProfile" Margin="8,16,0,0" VerticalAlignment="Top"/>
                                            <Button x:Name="VpnDeleteProfileButton" Grid.Column="2" Style="{StaticResource GhostButton}"
                                                    Content="Supprimer" Click="OnVpnDeleteProfile" Margin="8,16,0,0" VerticalAlignment="Top"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Ellipse x:Name="VpnDot" Width="12" Height="12" Fill="#64748B" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="VpnStatus" Text="Déconnecté" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock x:Name="VpnIpText" Grid.Column="1" Text="" Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Adresse du serveur (IP ou DNS du NAS)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                <TextBox x:Name="VpnServer" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                         BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Type" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                <ComboBox x:Name="VpnType" Margin="0,3,0,0" SelectedIndex="0"
                                                          SelectionChanged="OnVpnTypeChanged">
                                                    <ComboBoxItem Content="L2TP/IPSec"/>
                                                    <ComboBoxItem Content="SSTP"/>
                                                    <ComboBoxItem Content="PPTP"/>
                                                    <ComboBoxItem Content="Automatique"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Nom d'utilisateur" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                <TextBox x:Name="VpnUser" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                         BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Mot de passe" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                <PasswordBox x:Name="VpnPassword" Background="#0A1726"
                                                             BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel x:Name="VpnPskPanel" Margin="0,10,0,0">
                                            <TextBlock Text="Clé pré-partagée (L2TP/IPSec — « Clé secrète » du NAS)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                            <PasswordBox x:Name="VpnPsk" Background="#0A1726"
                                                         BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button x:Name="VpnConnectButton" Style="{StaticResource PrimaryButton}"
                                                    Content="SE CONNECTER" Click="OnVpnConnect" Width="170"/>
                                            <Button x:Name="VpnDisconnectButton" Style="{StaticResource GhostButton}"
                                                    Content="Déconnecter" Click="OnVpnDisconnect" Margin="10,0,0,0" IsEnabled="False"/>
                                            <CheckBox x:Name="VpnSaveCreds" Content="Mémoriser (chiffré)" Foreground="{StaticResource TextMutedBrush}"
                                                      VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11" IsChecked="True"/>
                                        </StackPanel>
                                        <TextBlock x:Name="VpnLog" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ================= PAGE : COFFRE-FORT ================= -->
                    <Grid x:Name="PageVault" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Coffre-fort" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Stockez vos mots de passe, chiffrés sur votre PC (DPAPI). Rien n'est envoyé sur Internet."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"/>
                        </StackPanel>

                        <!-- Formulaire d'ajout -->
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Ajouter une entrée" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Titre (ex. Gmail)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        <TextBox x:Name="VaultTitle" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Identifiant / e-mail" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        <TextBox x:Name="VaultUser" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Mot de passe" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        <TextBox x:Name="VaultPassword" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Site / URL (optionnel)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        <TextBox x:Name="VaultUrl" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Notes (optionnel)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        <TextBox x:Name="VaultNotes" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="VaultGenButton" Grid.Column="3" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom"
                                            Content="Générer" Click="OnVaultGenerate" Margin="10,0,0,0"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="VaultAddButton" Style="{StaticResource PrimaryButton}" Content="AJOUTER AU COFFRE" Click="OnVaultAdd" Width="200"/>
                                    <TextBlock x:Name="VaultStatus" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Liste des entrées -->
                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
                            <ListBox x:Name="VaultList" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#22FFFFFF" CornerRadius="8" Padding="12" Margin="0,3"
                                                BorderBrush="#3344E0FF" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{Binding Username}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding DisplayPassword}" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="12" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Url}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"
                                                               Visibility="{Binding UrlVisibility}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource GhostButton}" Content="Afficher" Click="OnVaultReveal" Tag="{Binding}" Margin="0,0,6,0"/>
                                                    <Button Style="{StaticResource GhostButton}" Content="Copier id." Click="OnVaultCopyUser" Tag="{Binding}" Margin="0,0,6,0"/>
                                                    <Button Style="{StaticResource GhostButton}" Content="Copier m.d.p." Click="OnVaultCopyPassword" Tag="{Binding}" Margin="0,0,6,0"/>
                                                    <Button Style="{StaticResource GhostButton}" Content="Supprimer" Click="OnVaultDelete" Tag="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- ============ PAGE : CENTRE DE SÉCURITÉ ============ -->
                    <Grid x:Name="PageCentre" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Centre de sécurité" Style="{StaticResource PageTitle}"/>

                                <!-- Score de sécurité -->
                                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Width="150" VerticalAlignment="Center">
                                            <TextBlock x:Name="ScoreValue" Text="—" Foreground="{StaticResource AccentBrush}"
                                                       FontSize="56" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="sur 100" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="ScoreGrade" Text="" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"
                                                       FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                                            <Button x:Name="ScoreRefreshButton" Style="{StaticResource GhostButton}" Content="Évaluer"
                                                    Click="OnComputeScore" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                            <TextBlock Text="Score de sécurité du PC" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="Note globale et recommandations personnalisées." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,8"/>
                                            <ItemsControl x:Name="ScoreList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" Foreground="{Binding Color}" FontWeight="Bold" Width="22"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                                                <TextBlock Text="{Binding Advice}" Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                                                                           TextWrapping="Wrap" Visibility="{Binding AdviceVisibility}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Mode Panic -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0" BorderBrush="#E5484D" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🚨 Mode Panic" Foreground="#FF6B6B" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="En cas d'urgence : coupe Internet, bloque les périphériques USB, arrête les processus suspects (lancés depuis les dossiers temporaires/Téléchargements) et verrouille la session. Réversible."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="PanicButton" Content="ACTIVER LE MODE PANIC" Click="OnPanicEngage"
                                                    Background="#E5484D" Foreground="White" BorderThickness="0" Padding="16,9" Cursor="Hand" FontWeight="Bold"/>
                                            <Button x:Name="PanicOffButton" Style="{StaticResource GhostButton}" Content="Rétablir (réseau + USB)"
                                                    Click="OnPanicDisengage" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="PanicStatus" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Surveillance du presse-papiers -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="📋 Surveillance du presse-papiers (anti-arnaque crypto)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="Détecte les malwares qui remplacent une adresse de cryptomonnaie copiée par celle d'un pirate." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ClipboardGuardSwitch" Grid.Column="1" Content="Activé" IsChecked="True"
                                                      Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Click="OnToggleClipboardGuard"/>
                                        </Grid>
                                        <TextBlock x:Name="ClipboardStatus" Text="En attente d'une copie d'adresse crypto…" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Protection webcam & micro -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="📷 Protection webcam &amp; micro" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="Liste les applications qui utilisent (ou ont utilisé) votre caméra et votre microphone." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="MediaScanButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="Vérifier" Click="OnScanMedia" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ItemsControl x:Name="MediaList" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Device}" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding App}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding Color}" FontSize="10" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="MediaStatus" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Mode Gamer -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="🎮 Mode Gamer" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="Suspend les notifications et allège l'analyse, sans jamais désactiver la protection." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="GamerModeSwitch" Grid.Column="1" Content="Activé"
                                                      Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Click="OnToggleGamerMode"/>
                                        </Grid>
                                        <TextBlock x:Name="GamerStatus" Text="Désactivé." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ======== PAGE : CENTRE D'INVESTIGATION ======== -->
                    <Grid x:Name="PageInvestigation" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Centre d'investigation" Style="{StaticResource PageTitle}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,8">
                            <Button x:Name="InvRefreshButton" Style="{StaticResource PrimaryButton}" Content="Actualiser la chronologie" Click="OnRefreshInvestigation"/>
                            <Button x:Name="InvExportButton" Style="{StaticResource GhostButton}" Content="Exporter le rapport" Click="OnExportInvestigation" Margin="10,0,0,0"/>
                            <Button x:Name="InvClearButton" Style="{StaticResource GhostButton}" Content="Vider" Click="OnClearInvestigation" Margin="8,0,0,0"/>
                            <TextBlock x:Name="InvStatus" Text="Chronologie horodatée des évènements de sécurité." Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <ListBox x:Name="InvList" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Pastille + ligne de temps -->
                                            <StackPanel Grid.Column="0" Width="14" HorizontalAlignment="Center">
                                                <Ellipse Width="12" Height="12" Fill="{Binding Color}"/>
                                                <Rectangle Width="2" Fill="#2A3B55" VerticalAlignment="Stretch" Height="40" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#22FFFFFF" CornerRadius="8" Padding="10" Margin="8,0,0,0"
                                                    BorderBrush="{Binding Color}" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentBrush}" FontSize="9" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- ========== PAGE : JUMEAU NUMÉRIQUE ========== -->
                    <Grid x:Name="PageTwin" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Jumeau numérique &amp; ADN des logiciels" Style="{StaticResource PageTitle}"/>
                        <TextBlock Grid.Row="1" Text="Capture une empreinte complète du système (applications + versions, services, pilotes, démarrage, tâches, fichier hosts) et détecte toute modification anormale — même sans malware connu."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="TwinCaptureButton" Style="{StaticResource GhostButton}" Content="Capturer l'empreinte de référence" Click="OnTwinCapture"/>
                            <Button x:Name="TwinCompareButton" Style="{StaticResource PrimaryButton}" Content="Comparer maintenant" Click="OnTwinCompare" Margin="10,0,0,0"/>
                            <TextBlock x:Name="TwinStatus" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Row="3" Style="{StaticResource Card}">
                            <ListBox x:Name="TwinList" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#22FFFFFF" CornerRadius="8" Padding="10" Margin="0,2" BorderBrush="{Binding Color}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Kind}" Foreground="{Binding Color}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Key}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Change}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- ========== PAGE : TABLEAU D'INTÉGRITÉ ========== -->
                    <Grid x:Name="PageIntegrity" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Tableau de bord d'intégrité" Style="{StaticResource PageTitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                    <TextBlock x:Name="IntegrityOverall" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="34" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="/100" Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Bottom" Margin="2,0,16,6"/>
                                    <Button x:Name="IntegrityRefreshButton" Style="{StaticResource GhostButton}" Content="Actualiser" Click="OnRefreshIntegrity" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="IntegrityStatus" Text="Santé globale du PC en temps réel." Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </StackPanel>
                                <ItemsControl x:Name="IntegrityList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Width="210" Height="120" Margin="0,0,12,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Display}" Foreground="{Binding Color}" FontSize="34" FontWeight="Bold" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- =============== PAGE : COPILOTE IA ================ -->
                    <Grid x:Name="PageCopilot" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.25*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Conversation -->
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="🤖 Copilote cybersécurité" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock x:Name="CopilotHint" Text="Propulsé par Claude. Posez une question ou laissez-le vous alerter en cas d'activité suspecte."
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ChatList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Bubble}" CornerRadius="10" Padding="10,8" Margin="0,4"
                                                        HorizontalAlignment="{Binding Align}" MaxWidth="460">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Sender}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ChatInput" Grid.Column="0" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" VerticalContentAlignment="Center"
                                             KeyDown="OnChatKeyDown"/>
                                    <Button x:Name="ChatSendButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Envoyer"
                                            Click="OnChatSend" Margin="8,0,0,0"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Outils IA -->
                        <StackPanel Grid.Column="2">
                            <!-- Détection d'arnaques -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="🎣 Détecter une arnaque" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Collez un e-mail, un SMS ou une URL : l'IA repère le phishing." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                    <TextBox x:Name="ScamInput" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource PanelStrokeBrush}"
                                             Padding="8" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                    <Button x:Name="ScamButton" Style="{StaticResource GhostButton}" Content="Analyser" Click="OnAnalyzeScam" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="ScamResult" Text="" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Analyse prédictive -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="🔮 Analyse prédictive d'un fichier" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Estime la probabilité qu'un fichier soit malveillant, avant toute signature." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                    <Button x:Name="PredictButton" Style="{StaticResource GhostButton}" Content="Choisir un fichier…" Click="OnPredictFile" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="PredictResult" Text="" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- =================== PAGE : APPAREIL ================== -->
                    <Grid x:Name="PageDevice" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Sécurité des appareils" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="État de la sécurité matérielle intégrée à votre appareil."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,8"/>
                                <Button x:Name="DeviceCheckButton" Style="{StaticResource PrimaryButton}" Width="220"
                                        HorizontalAlignment="Left" Content="VÉRIFIER L'ÉTAT" Click="OnCheckDevice"/>

                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🧩 Isolation du noyau" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Protège le noyau Windows contre les attaques mémoire." Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="CoreIsolationStatus" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🔐 Processeur de sécurité (TPM)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Module de plateforme sécurisée — chiffrement matériel." Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="TpmStatus" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,6,0,6"/>
                                        <Button x:Name="OpenTpmButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                Content="Ouvrir la gestion du TPM" Click="OnOpenTpm"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🛡️ Démarrage sécurisé (Secure Boot)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Empêche le chargement de logiciels non signés au démarrage." Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="SecureBootStatus" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="💾 Chiffrement de données (BitLocker)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Protège vos données en cas de perte ou de vol de l'appareil." Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="BitLockerStatus" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,6,0,6"/>
                                        <Button x:Name="OpenBitlockerButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                Content="Gérer le chiffrement BitLocker" Click="OnOpenBitlocker"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RingRotate" Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:18" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="CoreGlow" Storyboard.TargetProperty="Opacity"
                                     From="0.25" To="0.8" Duration="0:0:1.4" AutoReverse="True"
                                     RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
