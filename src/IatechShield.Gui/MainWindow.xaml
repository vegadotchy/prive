<Window x:Class="IatechShield.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IATECH-SHIELD PRO" Height="820" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" MinWidth="1080" MinHeight="720"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        Icon="/icon.ico"
        ShowInTaskbar="True"
        KeyDown="OnWindowKeyDown">

    <Border x:Name="RootBorder" CornerRadius="16" Background="{StaticResource WindowBackground}"
            BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Fond grille HUD (derrière tout le contenu) -->
            <Rectangle Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False" Opacity="0.5"
                       RadiusX="16" RadiusY="16">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,46,46" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Geometry="M0,0 L46,0 M0,0 L0,46">
                                <GeometryDrawing.Pen>
                                    <Pen Thickness="1" Brush="#0E2A3F"/>
                                </GeometryDrawing.Pen>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ======================= BARRE LATÉRALE ======================= -->
            <Border Grid.Column="0" Grid.Row="0" Background="#0A1726" CornerRadius="16,0,0,0">
                <DockPanel Margin="0,18">
                    <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <!-- Logo bouclier « or 3D » : glyphe doré bombé + ombre portée + halo. -->
                        <Grid HorizontalAlignment="Center">
                            <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                       HorizontalAlignment="Center" Margin="1.6,2,0,0" Foreground="#90000000"/>
                            <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                       HorizontalAlignment="Center" Foreground="{StaticResource GoldIconBright}">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FBBF24" BlurRadius="18" ShadowDepth="0" Opacity="0.75"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="IATECH" Foreground="{StaticResource GoldIconBright}"
                                   FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock Text="SHIELD" Foreground="{StaticResource GoldBrush}"
                                   FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE80F;" IsChecked="True" Content="Dashboard" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE72E;" Content="Protection" Checked="OnNav"/>
                        <RadioButton x:Name="NavScan" Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE721;" Content="Scan" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE83D;" Content="Firewall" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xEC4A;" Content="Optimisation" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE772;" Content="Périphériques" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE72E;" Content="Outils" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE968;" Content="Réseau" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE9D9;" Content="Radar" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE8CE;" Content="VPN" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE72E;" Content="Coffre-fort" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xEA18;" Content="Centre" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE9D2;" Content="Intégrité" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE8EC;" Content="Jumeau" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE9F9;" Content="Investigation" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE99A;" Content="Copilote" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE950;" Content="Appareil" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE77B;" Content="Système" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE9D5;" Content="Processus" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE909;" Content="Mondiale" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE8A1;" Content="ADN" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE9A9;" Content="Menaces" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE81C;" Content="Timeline" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE713;" Content="Settings" Checked="OnNav"/>
                        <RadioButton x:Name="NavLogs" Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE7C3;" Content="Logs" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE8D7;" Content="Accès" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE703;" Content="Accès distant" Checked="OnNav"/>
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                     Tag="&#xE77B;" Content="Registre ID" Checked="OnNav"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- =========================== CONTENU =========================== -->
            <Grid Grid.Column="1" Margin="22,16,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- En-tête -->
                <Grid Grid.Row="0" MouseLeftButtonDown="OnHeaderDrag" Background="Transparent">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Petit bouclier doré devant le titre. -->
                        <TextBlock Text="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource GoldIconBright}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FBBF24" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="IATECH-SHIELD " FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource GoldIconBright}">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#5A2E00" BlurRadius="2" ShadowDepth="1.2" Direction="270" Opacity="0.8"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="PRO" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource GoldBrush}"/>
                        <TextBlock x:Name="HeaderVersion" Text="" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom" Margin="6,0,0,3"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="LicenseBadge" Background="#0E2A3F" CornerRadius="8" Padding="10,4"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="LicenseStatusText" Text="Essai" FontSize="11"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <Button x:Name="AccountButton" Content="Compte" Click="OnOpenAccount" Style="{x:Null}"
                                FontSize="11" Height="26" Padding="10,0" Cursor="Hand" Margin="0,0,8,0"
                                Foreground="White" Background="#2A3550" BorderThickness="0"
                                ToolTip="Se connecter (Google ou e-mail) pour retrouver sa licence après réinstallation"/>
                        <Button x:Name="AiButton" Content="Assistant IA" Click="OnAiAssistant" Style="{x:Null}"
                                FontSize="11" Height="26" Padding="10,0" Cursor="Hand" Margin="0,0,8,0"
                                Foreground="White" Background="#16607A" BorderThickness="0"/>
                        <Button x:Name="ActivateButton" Content="Activer" Click="OnOpenLicense" Style="{x:Null}"
                                FontSize="11" Height="26" Padding="10,0" Cursor="Hand" Margin="0,0,8,0"
                                Foreground="White" Background="#1577C9" BorderThickness="0"/>
                        <Button Content="&#xE738;" Click="OnMinimize" Style="{x:Null}"
                                FontFamily="Segoe MDL2 Assets" FontSize="11" Width="30" Height="26"
                                Foreground="{StaticResource TextMutedBrush}" Background="Transparent"
                                BorderThickness="0" Cursor="Hand"/>
                        <Button x:Name="MaximizeButton" Content="&#xE922;" Click="OnToggleMaximize" Style="{x:Null}"
                                ToolTip="Plein écran (F11)"
                                FontFamily="Segoe MDL2 Assets" FontSize="11" Width="30" Height="26"
                                Foreground="{StaticResource TextMutedBrush}" Background="Transparent"
                                BorderThickness="0" Cursor="Hand"/>
                        <Button Content="&#xE711;" Click="OnClose" Style="{x:Null}"
                                FontFamily="Segoe MDL2 Assets" FontSize="11" Width="30" Height="26"
                                Foreground="{StaticResource TextMutedBrush}" Background="Transparent"
                                BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- ========================= PAGES ========================= -->
                <Grid Grid.Row="1" Margin="0,12,0,0">

                    <!-- Bande d'accent colorée par onglet (animée) -->
                    <Border x:Name="AccentStrip" Height="3" VerticalAlignment="Top" CornerRadius="2"
                            Background="{StaticResource AccentBrush}" Panel.ZIndex="10"
                            HorizontalAlignment="Stretch" Margin="0,-9,0,0"/>

                    <!-- ================= PAGE : DASHBOARD ================= -->
                    <Grid x:Name="PageDashboard">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Bandeau KPI animé -->
                        <UniformGrid Grid.Row="0" Rows="1" Columns="5" Margin="0,0,0,6">
                            <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="🛡️ Menaces (session)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    <TextBlock x:Name="KpiThreats" Text="0" Foreground="{StaticResource GreenBrush}" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0,6,0" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="🧬 Signatures" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    <TextBlock x:Name="KpiSignatures" Text="0" Foreground="{StaticResource AccentBrush}" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0,6,0" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="💚 Score sécurité" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="KpiScore" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="26" FontWeight="Bold"/>
                                        <TextBlock Text="/100" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0,6,0" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="📡 Appareils réseau" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    <TextBlock x:Name="KpiDevices" Text="0" Foreground="{StaticResource AccentBrush}" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="⚡ Temps réel" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                    <TextBlock x:Name="KpiRealtime" Text="—" Foreground="{StaticResource GreenBrush}" FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="290"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <!-- RAM en temps réel (gauche du cœur) -->
                                <Border Style="{StaticResource Card}" HorizontalAlignment="Left" VerticalAlignment="Center" Width="210" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="🧠 RAM" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="RamPercent" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="28" FontWeight="Bold"/>
                                        <ProgressBar x:Name="RamBar" Height="6" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}" Background="#1A2740" BorderThickness="0" Margin="0,2,0,4"/>
                                        <TextBlock x:Name="RamDetail" Text="—" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,8,0,6"/>
                                        <TextBlock Text="Top 3 RAM" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="SemiBold"/>
                                        <StackPanel x:Name="TopRamProcs" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- CPU en temps réel (droite du cœur) -->
                                <Border Style="{StaticResource Card}" HorizontalAlignment="Right" VerticalAlignment="Center" Width="210" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="⚙️ CPU" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="CpuPercent" Text="—" Foreground="{StaticResource GreenBrush}" FontSize="28" FontWeight="Bold"/>
                                        <ProgressBar x:Name="CpuBar" Height="6" Minimum="0" Maximum="100" Foreground="{StaticResource GreenBrush}" Background="#1A2740" BorderThickness="0" Margin="0,2,0,4"/>
                                        <TextBlock x:Name="CpuDetail" Text="charge processeur" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,8,0,6"/>
                                        <TextBlock Text="Top 3 CPU" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="SemiBold"/>
                                        <StackPanel x:Name="TopCpuProcs" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Grid Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="300" Height="300" Stroke="#143247" StrokeThickness="1"/>
                                    <Ellipse x:Name="RingOuter" Width="270" Height="270" Stroke="{StaticResource AccentDimBrush}"
                                             StrokeThickness="1.5" StrokeDashArray="2 6" Opacity="0.7">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="RingRotate" CenterX="135" CenterY="135"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="MainRing" Width="220" Height="220" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Opacity="0.85">
                                        <Ellipse.Effect>
                                            <DropShadowEffect x:Name="MainRingGlow" Color="#22D3E8" BlurRadius="25" ShadowDepth="0" Opacity="0.7"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <!-- Nœuds connectés en orbite autour du cœur -->
                                    <Canvas Width="300" Height="300" RenderTransformOrigin="0.5,0.5">
                                        <Canvas.RenderTransform>
                                            <RotateTransform x:Name="OrbitRotate" CenterX="150" CenterY="150"/>
                                        </Canvas.RenderTransform>
                                        <Ellipse Width="14" Height="14" Canvas.Left="278" Canvas.Top="143" Fill="{StaticResource AccentBrush}" Opacity="0.85"/>
                                        <Ellipse Width="14" Height="14" Canvas.Left="210" Canvas.Top="260" Fill="{StaticResource GreenBrush}" Opacity="0.8"/>
                                        <Ellipse Width="14" Height="14" Canvas.Left="76" Canvas.Top="260" Fill="{StaticResource AccentBrush}" Opacity="0.75"/>
                                        <Ellipse Width="14" Height="14" Canvas.Left="8" Canvas.Top="143" Fill="{StaticResource AccentDimBrush}" Opacity="0.85"/>
                                        <Ellipse Width="14" Height="14" Canvas.Left="76" Canvas.Top="26" Fill="{StaticResource GreenBrush}" Opacity="0.8"/>
                                        <Ellipse Width="14" Height="14" Canvas.Left="210" Canvas.Top="26" Fill="{StaticResource AccentBrush}" Opacity="0.75"/>
                                    </Canvas>

                                    <Grid Width="210" Height="210">
                                        <!-- Halo qui pulse au rythme du cœur -->
                                        <Ellipse x:Name="CoreGlow" Width="210" Height="210" Fill="#1A22D3E8"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="GlowScale" ScaleX="1" ScaleY="1"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <!-- Cœur, plus grand, qui bat comme un vrai cœur -->
                                        <Path x:Name="HeartPath" Data="M75,128 C40,100 18,78 18,52 C18,33 33,20 50,20 C61,20 70,26 75,36 C80,26 89,20 100,20 C117,20 132,33 132,52 C132,78 110,100 75,128 Z"
                                              Stretch="Uniform" Width="132" Height="132"
                                              Fill="#11314A" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5"
                                              RenderTransformOrigin="0.5,0.55">
                                            <Path.RenderTransform>
                                                <ScaleTransform x:Name="HeartScale" ScaleX="1" ScaleY="1"/>
                                            </Path.RenderTransform>
                                            <Path.Effect>
                                                <DropShadowEffect x:Name="HeartGlow" Color="#22D3E8" BlurRadius="22" ShadowDepth="0" Opacity="0.9"/>
                                            </Path.Effect>
                                        </Path>
                                        <Ellipse x:Name="CoreDot" Width="30" Height="30" Fill="{StaticResource AccentBrush}"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="CoreDotScale" ScaleX="1" ScaleY="1"/>
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Effect>
                                                <DropShadowEffect x:Name="CoreDotGlow" Color="#22D3E8" BlurRadius="34" ShadowDepth="0" Opacity="1"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Grid>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-6,0,0,0"
                                            Background="#0E2A3F" CornerRadius="8" Padding="10,6"
                                            BorderBrush="{StaticResource GreenBrush}" BorderThickness="1">
                                        <TextBlock x:Name="ShieldStatusText" Text="PROTÉGÉ" Foreground="{StaticResource GreenBrush}"
                                                   FontWeight="Bold" FontSize="13"/>
                                    </Border>
                                </Grid>
                            </Grid>

                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Activité du Système" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <Polyline Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" Margin="0,12,0,0"
                                                  Points="0,30 15,22 30,34 45,12 60,26 75,8 90,28 105,18 120,32 135,14 150,24 165,10 180,26 195,20 210,30"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Updates information" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock x:Name="UpdatesDateText" Text="Base de données à jour"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="SignatureCountText" Text="" Foreground="{StaticResource AccentBrush}"
                                                   FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Informations système -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="💻 Informations système" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="SysOs" Text="Windows : —" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,1" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SysCpu" Text="Processeur : —" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,1" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SysRam" Text="Mémoire : —" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,1"/>
                                        <TextBlock x:Name="SysGpu" Text="Carte graphique : —" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,1" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SysMachine" Text="Machine : —" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,1" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="SysInstall" Text="Installé le : —" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,1"/>
                                        <TextBlock Text="Disques :" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,4,0,1"/>
                                        <ItemsControl x:Name="SysDisks">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="6,1,0,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Analyse rapide" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="ScanStatusText" Text="Prêt à analyser." Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                    <ProgressBar x:Name="ScanProgress" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                                 Visibility="Collapsed" Foreground="{StaticResource AccentBrush}"
                                                 Background="#1A2740" BorderThickness="0"/>
                                    <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                                            Click="OnQuickScan">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="LANCER L'ANALYSE RAPIDE" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PauseScanButton" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                            Click="OnPauseScan" Visibility="Collapsed" Content="⏸ PAUSE"
                                            Foreground="{StaticResource GoldBrush}" BorderBrush="{StaticResource GoldBrush}"/>
                                    <Button x:Name="StopScanButton" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                            Click="OnStopScan" Visibility="Collapsed"
                                            Foreground="#FF6B6B" BorderBrush="#FF6B6B">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="ARRÊTER LE SCAN" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="SecurityTestButton" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                            Click="OnSecurityTest" Content="🧪 TESTER MA SÉCURITÉ"
                                            Foreground="{StaticResource GreenBrush}" BorderBrush="{StaticResource GreenBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Menaces Détectées" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ThreatCountText" Text="0" Foreground="{StaticResource GreenBrush}"
                                               FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="ThreatStatusText" Text="SÉCURISÉ" Foreground="{StaticResource GreenBrush}"
                                               FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ReactorPulseText" Text="Pulsations du cœur-réacteur : STABLES"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                                               HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ================= PAGE : PROTECTION ================= -->
                    <Grid x:Name="PageProtection" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Protection En Direct" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Activez les boucliers de protection en temps réel."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14"/>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Protection en Temps Réel" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="Analyse les fichiers à leur création/modification." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="RealtimeSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="False" Checked="OnRealtimeToggled" Unchecked="OnRealtimeToggled"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,8"/>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Bouclier Anti-Ransomware" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="Canaris + arrêt du processus chiffrant (Documents, Images, Bureau)." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="RansomwareSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="False" Checked="OnRansomwareToggled" Unchecked="OnRansomwareToggled"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,8"/>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Démarrer avec Windows" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="Inscrit IATECH-SHIELD au démarrage (registre)." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="AutostartSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="False" Checked="OnAutostartToggled" Unchecked="OnAutostartToggled"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ===== Programmateur de connexion Internet ===== -->
                            <TextBlock Text="⏰ Programmateur de connexion Internet" Foreground="{StaticResource GoldBrush}"
                                       FontWeight="SemiBold" FontSize="14" Margin="0,18,0,8"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Couper Internet automatiquement à une heure" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="À l'heure de coupure, Internet est bloqué ; à l'heure de rétablissement, il est rétabli (idéal contrôle parental / nuit)." Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="NetScheduleSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                      IsChecked="False" Checked="OnNetScheduleToggled" Unchecked="OnNetScheduleToggled"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,8"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔴 Couper à" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox x:Name="NetCutTime" Text="22:00" Width="70" Margin="8,0,18,0" FontSize="13"
                                                 Background="#0E2233" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource PanelStrokeBrush}"
                                                 BorderThickness="1" Padding="6,4" HorizontalContentAlignment="Center"/>
                                        <TextBlock Text="🟢 Rétablir à" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBox x:Name="NetRestoreTime" Text="07:00" Width="70" Margin="8,0,0,0" FontSize="13"
                                                 Background="#0E2233" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource PanelStrokeBrush}"
                                                 BorderThickness="1" Padding="6,4" HorizontalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="🔴 Couper Internet maintenant" Style="{StaticResource GhostButton}" Click="OnCutNetNow" Margin="0,0,8,0"/>
                                        <Button Content="🟢 Rétablir Internet" Style="{StaticResource GhostButton}" Click="OnRestoreNetNow"/>
                                    </StackPanel>
                                    <TextBlock x:Name="NetScheduleStatus" Text="" Foreground="{StaticResource GoldBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- ===== Contrôle & accès ===== -->
                            <TextBlock Text="🛡️ Contrôle &amp; accès" Foreground="{StaticResource GoldBrush}"
                                       FontWeight="SemiBold" FontSize="14" Margin="0,18,0,8"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Contrôle parental" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="Limites de temps d'écran, sites web et applications par compte enfant." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <Button Content="Configurer" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Tag="ms-settings:family-group" Click="OnProtTool"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,8"/>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Contrôle des applications et du navigateur" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="SmartScreen : bloque les applis et téléchargements dangereux." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <Button Content="Ouvrir" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Tag="windowsdefender://appbrowser" Click="OnProtTool"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,8"/>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Sécurité des appareils" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="Isolation du noyau, intégrité de la mémoire, processeur de sécurité (TPM)." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <Button Content="Ouvrir" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Tag="windowsdefender://devicesecurity" Click="OnProtTool"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,8"/>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Protection de compte" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="Compte Microsoft, Windows Hello, verrouillage dynamique." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <Button Content="Ouvrir" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Tag="windowsdefender://account" Click="OnProtTool"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ===== Réseau &amp; pare-feu ===== -->
                            <TextBlock Text="🌐 Réseau &amp; pare-feu" Foreground="{StaticResource GoldBrush}"
                                       FontWeight="SemiBold" FontSize="14" Margin="0,18,0,8"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Protection réseau et pare-feu" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="État du pare-feu pour les réseaux privés, publics et de domaine." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <Button Content="Ouvrir" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Tag="windowsdefender://network" Click="OnProtTool"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,8"/>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Exceptions du pare-feu" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="Autoriser un programme à travers le pare-feu, ou retirer l'autorisation." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Autoriser une app" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnFirewallAllow"/>
                                            <Button Content="Règles avancées" Style="{StaticResource GhostButton}" Tag="wf.msc" Click="OnProtTool"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,8"/>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Mode furtif (bloquer le ping / ICMP)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="Rend le PC invisible aux pings sur le réseau (anti-scan)." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="StealthSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="False" Checked="OnStealthToggled" Unchecked="OnStealthToggled"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,8"/>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Protection USB (bloquer l'exécution auto)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="Désactive l'AutoRun des clés USB et disques (anti-ver USB)." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="UsbGuardSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="False" Checked="OnUsbGuardToggled" Unchecked="OnUsbGuardToggled"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ===== Web, virus &amp; historique ===== -->
                            <TextBlock Text="🦠 Virus, Web &amp; historique" Foreground="{StaticResource GoldBrush}"
                                       FontWeight="SemiBold" FontSize="14" Margin="0,18,0,8"/>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                <StackPanel>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Protection contre les virus et menaces" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="Sécurité Windows : analyses, menaces actives, protection cloud." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <Button Content="Ouvrir" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Tag="windowsdefender://threat" Click="OnProtTool"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,8"/>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Protection Web / anti-hameçonnage" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="Active le filtre SmartScreen Microsoft Defender (sites malveillants)." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="WebGuardSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="True" Checked="OnWebGuardToggled" Unchecked="OnWebGuardToggled"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,8"/>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Historique de protection" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock Text="Journal des incidents, détections et actions d'IATECH-SHIELD." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Voir le journal" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnOpenProtectionHistory"/>
                                            <Button Content="Windows" Style="{StaticResource GhostButton}" Tag="windowsdefender://history" Click="OnProtTool"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ==================== PAGE : SCAN ==================== -->
                    <Grid x:Name="PageScan" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Options de scan -->
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Analyser" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Choisissez ce qui doit être analysé :" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11" Margin="0,0,0,10"/>

                                <CheckBox x:Name="ChkHardDrives" Style="{StaticResource Check}" Content="Disques durs (fixes)"/>
                                <CheckBox x:Name="ChkRemovable"  Style="{StaticResource Check}" Content="Disques amovibles (clés USB)"/>
                                <CheckBox x:Name="ChkAllFiles"   Style="{StaticResource Check}" Content="Tous les fichiers (analyse complète)"/>
                                <CheckBox x:Name="ChkFolder"     Style="{StaticResource Check}" Content="Dossier spécifique…"/>
                                <CheckBox x:Name="ChkFile"       Style="{StaticResource Check}" Content="Fichier spécifique…"/>
                                <CheckBox x:Name="ChkMail"       Style="{StaticResource Check}" Content="Courriels (Outlook / Thunderbird)"/>
                                <CheckBox x:Name="ChkStartup"    Style="{StaticResource Check}" Content="Mémoire et démarrage"/>

                                <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,12"/>

                                <TextBlock Text="Après le scan complet :" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="12" Margin="0,0,0,6"/>
                                <RadioButton x:Name="PostNone" GroupName="post" Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="12" Margin="0,3" IsChecked="True" Content="Ne rien faire"/>
                                <RadioButton x:Name="PostShutdown" GroupName="post" Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="12" Margin="0,3" Content="Éteindre l'ordinateur"/>
                                <RadioButton x:Name="PostRestart" GroupName="post" Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="12" Margin="0,3" Content="Redémarrer l'ordinateur"/>

                                <Button x:Name="FullScanButton" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"
                                        Click="OnFullScan" Content="LANCER L'ANALYSE"/>
                                <Button x:Name="PauseFullScanButton" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                        Click="OnPauseScan" Visibility="Collapsed" Content="⏸ PAUSE"
                                        Foreground="{StaticResource GoldBrush}" BorderBrush="{StaticResource GoldBrush}"/>
                                <Button x:Name="StopFullScanButton" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                                        Click="OnStopScan" Visibility="Collapsed" Content="⏹ ARRÊTER LE SCAN"
                                        Foreground="#FF6B6B" BorderBrush="#FF6B6B"/>
                            </StackPanel>
                        </Border>

                        <!-- Résultats -->
                        <Border Grid.Column="1" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Résultats de l'analyse" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold" FontSize="14"/>
                                <StackPanel Grid.Row="1">
                                    <TextBlock x:Name="FullScanStatus" Text="En attente…" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="FullScanProgress" Height="6" Margin="0,8,0,8" Minimum="0" Maximum="100"
                                                 Visibility="Collapsed" Foreground="{StaticResource AccentBrush}"
                                                 Background="#1A2740" BorderThickness="0"/>
                                </StackPanel>
                                <ListBox Grid.Row="2" x:Name="ScanResultsList" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#26FFFFFF" CornerRadius="8" Padding="12" Margin="0,4"
                                                    BorderBrush="#3344E0FF" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="190"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="#FF6B6B"
                                                                   FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="{Binding Path}" Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1" Margin="8,0" VerticalAlignment="Center"
                                                              SelectedValuePath="Content"
                                                              SelectedValue="{Binding SelectedAction, Mode=TwoWay}">
                                                        <ComboBoxItem Content="Mettre en quarantaine"/>
                                                        <ComboBoxItem Content="Supprimer"/>
                                                        <ComboBoxItem Content="Analyser"/>
                                                        <ComboBoxItem Content="Ignorer"/>
                                                    </ComboBox>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="Expliquer (IA)" Style="{StaticResource GhostButton}"
                                                                Click="OnExplainThreat" Tag="{Binding}" Margin="0,0,6,0"/>
                                                        <Button Content="Appliquer" Style="{StaticResource GhostButton}"
                                                                Click="OnApplyThreatAction"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================== PAGE : FIREWALL ================== -->
                    <Grid x:Name="PageFirewall" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Pare-feu et protection du réseau" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Personnes et systèmes pouvant accéder à vos réseaux."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14"/>

                            <!-- Profils du pare-feu -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Profils du pare-feu Windows" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <Button x:Name="FwRefreshButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                                Content="Rafraîchir l'état" Click="OnFwRefresh"/>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Réseau avec domaine" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                            <TextBlock x:Name="FwDomainStatus" Text="—" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Activer" Tag="Domain True" Style="{StaticResource GhostButton}" Height="30" Click="OnFwAction" Margin="0,0,8,0"/>
                                            <Button Content="Désactiver" Tag="Domain False" Style="{StaticResource GhostButton}" Height="30" Click="OnFwAction"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Réseau privé" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                            <TextBlock x:Name="FwPrivateStatus" Text="—" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Activer" Tag="Private True" Style="{StaticResource GhostButton}" Height="30" Click="OnFwAction" Margin="0,0,8,0"/>
                                            <Button Content="Désactiver" Tag="Private False" Style="{StaticResource GhostButton}" Height="30" Click="OnFwAction"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Réseau public" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                            <TextBlock x:Name="FwPublicStatus" Text="—" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Activer" Tag="Public True" Style="{StaticResource GhostButton}" Height="30" Click="OnFwAction" Margin="0,0,8,0"/>
                                            <Button Content="Désactiver" Tag="Public False" Style="{StaticResource GhostButton}" Height="30" Click="OnFwAction"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <Grid Margin="0,4">
                                        <StackPanel>
                                            <TextBlock Text="Pare-feu Windows" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                                            <TextBlock x:Name="FirewallStateText" Text="État inconnu" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <Button x:Name="FirewallOpenButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                                Content="Ouvrir le pare-feu Windows" Click="OnOpenFirewall"/>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,10"/>
                                    <TextBlock Text="Connexions sortantes actives" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                                    <Button x:Name="ListConnButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                            Content="Lister les connexions" Click="OnListConnections"/>
                                    <ListBox x:Name="ConnectionsList" Background="#0A1726" BorderThickness="0" Height="220"
                                             Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ================== PAGE : SETTINGS ================== -->
                    <Grid x:Name="PageSettings" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Paramètres" Style="{StaticResource PageTitle}"/>
                            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Assistant IA (Claude)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="ApiKeyStatusText" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,6" TextWrapping="Wrap"/>
                                    <TextBlock Text="Collez votre clé Anthropic (commence par sk-ant-…). Obtenez-la sur console.anthropic.com → API Keys. Elle est stockée chiffrée sur ce PC, aucune variable d'environnement ni redémarrage requis."
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="ApiKeyInput" Grid.Column="0" Background="#0A1726"
                                                     BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" FontSize="12" VerticalContentAlignment="Center"/>
                                        <Button x:Name="ApiKeySaveButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                                Content="Enregistrer la clé" Click="OnSaveApiKey" Margin="10,0,0,0"/>
                                        <Button x:Name="ApiKeyGetButton" Grid.Column="2" Style="{StaticResource GhostButton}"
                                                Content="Obtenir une clé" Click="OnGetApiKey" Margin="8,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="📱 Connexion itsme (déverrouillage par notification téléphone)" Foreground="{StaticResource GoldBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="ItsmeStatusText" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,4" TextWrapping="Wrap"/>
                                    <TextBlock Text="itsme exige un contrat partenaire. Renseignez le client_id, le client_secret et le code de service fournis par itsme. Déclarez chez itsme l'URL de redirection : http://127.0.0.1:38220/itsme/callback. Une fois configuré, le bouton « itsme » de l'écran de verrouillage envoie une vraie notification sur votre téléphone."
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,8">
                                            <TextBlock Text="client_id" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                            <TextBox x:Name="ItsmeClientId" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource PanelStrokeBrush}" Padding="7" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,8">
                                            <TextBlock Text="code de service" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                            <TextBox x:Name="ItsmeServiceCode" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource PanelStrokeBrush}" Padding="7" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,8">
                                            <TextBlock Text="client_secret" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                            <PasswordBox x:Name="ItsmeClientSecret" Background="#0A1726" BorderBrush="{StaticResource PanelStrokeBrush}" Padding="7" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0,0,8">
                                            <TextBlock Text="environnement" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                            <ComboBox x:Name="ItsmeEnv" SelectedIndex="0">
                                                <ComboBoxItem Content="Production (prd)"/>
                                                <ComboBoxItem Content="Sandbox (e2e)"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                Content="Enregistrer itsme" Click="OnSaveItsme"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Enregistrement auto des identifiants (extension navigateur)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Quand vous vous connectez à un site, IATECH-SHIELD propose d'enregistrer l'identifiant dans le coffre-fort. Canal 100% local (127.0.0.1), rien ne sort du PC. Installez l'extension fournie dans Chrome/Edge (mode développeur → charger l'extension non empaquetée)."
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,6" TextWrapping="Wrap"/>
                                    <Button x:Name="OpenExtensionButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                            Content="Ouvrir le dossier de l'extension" Click="OnOpenExtensionFolder"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Adresse e-mail (pour l'envoi des journaux)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox x:Name="EmailInput" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,8,0,0" FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <!-- Options avancées -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Options de protection" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>

                                    <Grid Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Mode silencieux" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                            <TextBlock Text="Désactive les effets sonores." Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="SilentSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                      IsChecked="False" Checked="OnSilentToggled" Unchecked="OnSilentToggled"/>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,12"/>

                                    <TextBlock Text="Analyse planifiée" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                    <TextBlock Text="Lance automatiquement une analyse rapide à intervalle régulier." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="ScheduleCombo" Width="260" HorizontalAlignment="Left"
                                              SelectedValuePath="Content" SelectionChanged="OnScheduleChanged">
                                        <ComboBoxItem Content="Désactivée" IsSelected="True"/>
                                        <ComboBoxItem Content="Toutes les heures"/>
                                        <ComboBoxItem Content="Toutes les 6 heures"/>
                                        <ComboBoxItem Content="Une fois par jour"/>
                                    </ComboBox>

                                    <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,12"/>

                                    <TextBlock Text="Mise à jour des signatures" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                    <TextBlock Text="Télécharge une base de signatures depuis une URL (signatures.json)." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="UpdateUrlInput" Grid.Column="0" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" FontSize="12" VerticalContentAlignment="Center"/>
                                        <Button x:Name="UpdateSigButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                                Content="Mettre à jour" Click="OnUpdateSignatures" Margin="10,0,0,0"/>
                                    </Grid>
                                    <TextBlock x:Name="UpdateStatus" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Mise à jour de l'application -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Mise à jour de l'application" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="AppVersionText" Text="Version installée : —" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CheckUpdateButton" Style="{StaticResource GhostButton}"
                                                Content="Rechercher une mise à jour" Click="OnCheckUpdate"/>
                                        <Button x:Name="InstallUpdateButton" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                                Content="Télécharger et installer" Click="OnInstallUpdate" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AppUpdateStatus" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="AppUpdateProgress" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                                 Visibility="Collapsed" Foreground="{StaticResource AccentBrush}"
                                                 Background="#1A2740" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <!-- Réputation VirusTotal -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Réputation VirusTotal" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Vérifie un fichier via son hash SHA-256 sur 70+ antivirus (le fichier n'est pas envoyé)." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="VtApiKeyInput" Grid.Column="0" Background="#0A1726"
                                                     BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" FontSize="12" VerticalContentAlignment="Center"/>
                                        <Button x:Name="VtCheckFileButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                                Content="Vérifier un fichier" Click="OnVirusTotalCheck" Margin="10,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="Clé API VirusTotal (gratuite sur virustotal.com) — ou définissez VIRUSTOTAL_API_KEY." Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="VtStatus" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Protection anti-altération -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Protection par mot de passe (anti-altération)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Exige un mot de passe pour quitter l'application ou désactiver la protection en temps réel." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="TamperPwdInput" Grid.Column="0" Background="#0A1726"
                                                     BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" FontSize="12" VerticalContentAlignment="Center"/>
                                        <Button x:Name="TamperSetButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                                Content="Définir" Click="OnSetTamperPassword" Margin="10,0,0,0"/>
                                        <Button x:Name="TamperClearButton" Grid.Column="2" Style="{StaticResource GhostButton}"
                                                Content="Retirer" Click="OnClearTamperPassword" Margin="8,0,0,0"/>
                                    </Grid>
                                    <TextBlock x:Name="TamperStatus" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Verrou de session (écran de veille + PIN) -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Verrou de session (écran logo + PIN)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Après une période d'inactivité, affiche un écran plein écran au logo IATECH-SHIELD, déverrouillé par un code PIN. (Confidentialité visuelle, pas un verrou Windows.)" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="LockPinInput" Grid.Column="0" Background="#0A1726"
                                                     BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" FontSize="12" VerticalContentAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBox x:Name="LockDelayInput" Text="5" Width="44" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                     BorderBrush="{StaticResource PanelStrokeBrush}" Padding="6,4" VerticalContentAlignment="Center" TextAlignment="Center"/>
                                            <TextBlock Text="min" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="LockEnableButton" Grid.Column="2" Style="{StaticResource GhostButton}"
                                                Content="Activer" Click="OnEnableLock" Margin="10,0,0,0"/>
                                        <Button x:Name="LockDisableButton" Grid.Column="3" Style="{StaticResource GhostButton}"
                                                Content="Désactiver" Click="OnDisableLock" Margin="8,0,0,0"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="LockNowButton" Style="{StaticResource GhostButton}" Content="Verrouiller maintenant" Click="OnLockNow"/>
                                        <TextBlock x:Name="LockStatus" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Gestionnaire de quarantaine -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Gestionnaire de quarantaine" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <ListBox x:Name="QuarantineList" Background="#0A1726" BorderThickness="0" Height="140"
                                             Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,8,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="RefreshQuarantineButton" Style="{StaticResource GhostButton}"
                                                Content="Actualiser" Click="OnRefreshQuarantine" Margin="0,0,10,0"/>
                                        <Button x:Name="RestoreQuarantineButton" Style="{StaticResource GhostButton}"
                                                Content="Restaurer la sélection" Click="OnRestoreQuarantine" Margin="0,0,10,0"/>
                                        <Button x:Name="DeleteQuarantineButton" Style="{StaticResource GhostButton}"
                                                Content="Supprimer la sélection" Click="OnDeleteQuarantine"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Quarantaine &amp; licence" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="OpenQuarantineButton" Style="{StaticResource GhostButton}"
                                                Content="Ouvrir le dossier de quarantaine" Click="OnOpenQuarantine" Margin="0,0,10,0"/>
                                        <Button x:Name="DeactivateButton" Style="{StaticResource GhostButton}"
                                                Content="Désactiver la licence" Click="OnDeactivateLicense"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ==================== PAGE : LOGS ==================== -->
                    <Grid x:Name="PageLogs" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Journal d'activité" Style="{StaticResource PageTitle}"/>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,8">
                            <TextBox x:Name="LogBox" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="0" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                        </Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button x:Name="SendLogMailButton" Style="{StaticResource GhostButton}"
                                    Content="Envoyer par e-mail" Click="OnSendLogMail" Margin="0,0,10,0"/>
                            <Button x:Name="SaveLogButton" Style="{StaticResource GhostButton}"
                                    Content="Enregistrer le journal" Click="OnSaveLog" Margin="0,0,10,0"/>
                            <Button x:Name="ClearLogButton" Style="{StaticResource GhostButton}"
                                    Content="Effacer" Click="OnClearLog"/>
                        </StackPanel>
                    </Grid>

                    <!-- ==================== PAGE : ACCÈS (registre connexions) ==================== -->
                    <Grid x:Name="PageAccess" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Registre des accès" Style="{StaticResource PageTitle}"/>
                            <Button Style="{StaticResource GhostButton}" Content="Actualiser" Click="OnRefreshAccess"
                                    Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource GhostButton}" Content="Effacer" Click="OnClearAccess"
                                    Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="AccessStatus" Text="Qui a déverrouillé le poste, quand et comment (PIN, Windows Hello, itsme, carte d'identité)."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="AccessList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="22" VerticalAlignment="Center"
                                                           Margin="0,0,14,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Kind}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="{Binding Method}" Foreground="{Binding MethodColor}" FontWeight="SemiBold" FontSize="12" Margin="10,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Identity}" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding TimeText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ==================== PAGE : ACCÈS À DISTANCE ==================== -->
                    <Grid x:Name="PageRemote" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Accès à distance" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Donnez à un technicien de confiance l'accès à votre PC via AnyDesk ou TeamViewer — accès permanent ou temporaire, protégé par mot de passe."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap"/>

                                <!-- AnyDesk -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🖥️ AnyDesk" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock x:Name="AnyDeskStatus" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Léger et rapide. Idéal pour un dépannage ponctuel." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Lancer / Installer AnyDesk" Style="{StaticResource GhostButton}" Tag="anydesk" Click="OnRemoteLaunch" Margin="0,0,8,0"/>
                                            <Button Content="Télécharger" Style="{StaticResource GhostButton}" Tag="https://anydesk.com/fr/downloads/windows" Click="OnProtTool" Margin="0,0,8,0"/>
                                            <Button Content="Accès non surveillé" Style="{StaticResource GhostButton}" Tag="anydesk-settings" Click="OnRemoteLaunch"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- TeamViewer -->
                                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🤝 TeamViewer" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock x:Name="TeamViewerStatus" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Très répandu, compatible mobile. Pour un support complet." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Lancer / Installer TeamViewer" Style="{StaticResource GhostButton}" Tag="teamviewer" Click="OnRemoteLaunch" Margin="0,0,8,0"/>
                                            <Button Content="Télécharger" Style="{StaticResource GhostButton}" Tag="https://www.teamviewer.com/fr/telecharger/windows/" Click="OnProtTool"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Mot de passe & durée -->
                                <TextBlock Text="🔐 Mot de passe &amp; durée d'accès" Foreground="{StaticResource GoldBrush}"
                                           FontWeight="SemiBold" FontSize="14" Margin="0,18,0,8"/>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Mot de passe à communiquer au technicien (à saisir dans AnyDesk/TeamViewer pour l'accès non surveillé) :"
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="RemotePassword" Width="260" Text="" IsReadOnly="True" FontSize="16" FontFamily="Consolas"
                                                     Background="#0E2233" Foreground="{StaticResource GoldBrush}" BorderBrush="{StaticResource PanelStrokeBrush}"
                                                     BorderThickness="1" Padding="8,6" HorizontalContentAlignment="Center"/>
                                            <Button Content="Générer" Style="{StaticResource GhostButton}" Click="OnGenRemotePassword" Margin="8,0,0,0"/>
                                            <Button Content="Copier" Style="{StaticResource GhostButton}" Click="OnCopyRemotePassword" Margin="8,0,0,0"/>
                                        </StackPanel>

                                        <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,14"/>

                                        <TextBlock Text="Type d'accès :" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RemotePermanent" Content="Permanent" GroupName="remoteMode" Foreground="{StaticResource TextPrimaryBrush}" VerticalContentAlignment="Center" Margin="0,0,18,0"/>
                                            <RadioButton x:Name="RemoteTemporary" Content="Temporaire" GroupName="remoteMode" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                                            <ComboBox x:Name="RemoteDuration" Width="120" SelectedIndex="2" VerticalAlignment="Center">
                                                <ComboBoxItem Content="15 minutes"/>
                                                <ComboBoxItem Content="30 minutes"/>
                                                <ComboBoxItem Content="1 heure"/>
                                                <ComboBoxItem Content="4 heures"/>
                                                <ComboBoxItem Content="8 heures"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Content="✅ Activer l'accès" Style="{StaticResource PrimaryButton}" Width="180" Click="OnGrantRemote" Margin="0,0,10,0"/>
                                            <Button Content="⛔ Révoquer maintenant" Style="{StaticResource GhostButton}" Click="OnRevokeRemote"/>
                                        </StackPanel>
                                        <TextBlock x:Name="RemoteStatus" Text="" Foreground="{StaticResource GoldBrush}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="ℹ️ « Révoquer » ferme immédiatement AnyDesk et TeamViewer pour couper tout accès. En mode temporaire, l'accès est révoqué automatiquement à l'expiration."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ==================== PAGE : ID REGISTRE (cartes d'identité) ==================== -->
                    <Grid x:Name="PageIdRegister" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="ID Registre" Style="{StaticResource PageTitle}"/>
                            <Button Style="{StaticResource GhostButton}" Content="Actualiser" Click="OnRefreshIdRegister"
                                    Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource GhostButton}" Content="Effacer" Click="OnClearIdRegister"
                                    Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="IdRegisterStatus" Text="Chaque connexion par carte d'identité : nom, prénoms, date de naissance, n° national, heures et durée."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="IdRegisterList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14"
                                                BorderBrush="{Binding StateColor}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Compteur de durée en tête -->
                                                <Border Grid.Column="0" Background="#0E2233" CornerRadius="8" Padding="12,8" VerticalAlignment="Center" Margin="0,0,14,0"
                                                        BorderBrush="{Binding StateColor}" BorderThickness="1">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Duration}" Foreground="{Binding StateColor}" FontSize="18" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding StateText}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" FontSize="15"/>
                                                    <TextBlock Text="{Binding BirthLine}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding NationalLine}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,1,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding ConnectedLine}" Foreground="#33FF66" FontSize="11"/>
                                                    <TextBlock Text="{Binding DisconnectedLine}" Foreground="#FF6B6B" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ==================== PAGE : OUTILS ==================== -->
                    <Grid x:Name="PageTools" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Outils de protection" Style="{StaticResource PageTitle}"/>

                                <!-- Chiffrement de dossier -->
                                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🔒 Chiffrer un dossier (mot de passe)" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="AES-256. Produit un fichier .iasx protégé par mot de passe."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,8"/>
                                        <PasswordBox x:Name="CryptoPassword" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                     BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" FontSize="12"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="EncryptButton" Style="{StaticResource GhostButton}"
                                                    Content="Chiffrer un dossier…" Click="OnEncryptFolder" Margin="0,0,10,0"/>
                                            <Button x:Name="DecryptButton" Style="{StaticResource GhostButton}"
                                                    Content="Déchiffrer un .iasx…" Click="OnDecryptFolder"/>
                                        </StackPanel>
                                        <TextBlock x:Name="CryptoStatus" Text="" Foreground="{StaticResource AccentBrush}"
                                                   FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Clé USB protégée -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🔑 Protéger une clé USB" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Chiffre un dossier de la clé USB avec le mot de passe ci-dessus."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,8"/>
                                        <Button x:Name="UsbProtectButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                Content="Choisir un dossier sur la clé à protéger…" Click="OnProtectUsb"/>
                                    </StackPanel>
                                </Border>

                                <!-- Vérification d'URL -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🌐 Vérifier une URL / un site" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Indique si le lien est fiable, à surveiller ou dangereux (phishing, typosquatting…)."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="UrlInput" Grid.Column="0" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                     BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" FontSize="12"
                                                     VerticalContentAlignment="Center"/>
                                            <Button x:Name="CheckUrlButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                                    Content="Analyser" Click="OnCheckUrl" Margin="10,0,0,0"/>
                                        </Grid>
                                        <TextBlock x:Name="UrlVerdictText" Text="" FontSize="13" FontWeight="Bold" Margin="0,10,0,0"/>
                                        <TextBlock x:Name="UrlReasonsText" Text="" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Verrouillage PC -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🖥️ Verrouillage du PC" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Verrouille l'écran avec le logo IATECH-SHIELD. Déverrouillage par mot de passe, code PIN, ou Windows Hello (visage/empreinte)."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,8" TextWrapping="Wrap"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Mot de passe (optionnel)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                <PasswordBox x:Name="PcLockPassword" Background="#0A1726" BorderBrush="{StaticResource PanelStrokeBrush}"
                                                             Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Code PIN (optionnel)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                <PasswordBox x:Name="PcLockPin" Background="#0A1726" BorderBrush="{StaticResource PanelStrokeBrush}"
                                                             Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <CheckBox x:Name="PcHelloCheck" Content="Autoriser Windows Hello (reconnaissance faciale / empreinte)"
                                                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,10,0,0" Click="OnToggleHello"/>
                                        <TextBlock x:Name="PcHelloStatus" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button x:Name="SessionLockButton" Style="{StaticResource PrimaryButton}" Width="190"
                                                    Content="VERROUILLER MAINTENANT" Click="OnLockPcNow"/>
                                            <Button x:Name="PcLockSaveButton" Style="{StaticResource GhostButton}"
                                                    Content="Définir" Click="OnSetPcLock" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="ScreensaverButton" Style="{StaticResource GhostButton}" Margin="0,10,0,0"
                                                Click="OnScreensaver" HorizontalAlignment="Left"
                                                ToolTip="Écran noir avec cœur battant ; au réveil, demande le PIN / mot de passe">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🌙" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="ÉCRAN DE VEILLE" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="PcLockStatus" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>

                                        <Grid Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Exiger le mot de passe à la sortie de veille" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                            </StackPanel>
                                            <ToggleButton x:Name="WakePasswordSwitch" Style="{StaticResource Switch}"
                                                          HorizontalAlignment="Right" IsChecked="False"
                                                          Checked="OnWakePasswordToggled" Unchecked="OnWakePasswordToggled"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ==================== PAGE : RÉSEAU =================== -->
                    <Grid x:Name="PageNetwork" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Analyse du réseau" Style="{StaticResource PageTitle}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                            <Button x:Name="NetScanButton" Style="{StaticResource PrimaryButton}"
                                    Content="ANALYSER LE RÉSEAU" Click="OnNetworkScan" Width="220"/>
                            <TextBlock x:Name="NetStatus" Text="Détecte PC, imprimantes et appareils connectés."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="4,0,4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Adresse IP" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="Nom (modifiable)" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="Adresse MAC" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                                </Grid>
                                <ListBox Grid.Row="1" x:Name="NetworkList" Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#22FFFFFF" CornerRadius="8" Padding="10" Margin="0,3"
                                                    BorderBrush="#3344E0FF" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Ip}" VerticalAlignment="Center"
                                                               Foreground="{StaticResource AccentBrush}" FontFamily="Consolas"/>
                                                    <TextBox Grid.Column="1" Text="{Binding CustomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Margin="6,0" VerticalContentAlignment="Center"
                                                             Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                             BorderBrush="{StaticResource PanelStrokeBrush}" Padding="6,4"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Mac}" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="11"/>
                                                    <Button Grid.Column="3" Content="Renommer" Style="{StaticResource GhostButton}"
                                                            Height="30" Click="OnRenameDevice" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- =================== PAGE : SYSTÈME =================== -->
                    <Grid x:Name="PageSystem" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Compte, famille &amp; performances" Style="{StaticResource PageTitle}"/>

                                <!-- Protection du compte -->
                                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <StackPanel>
                                        <TextBlock Text="👤 Protection du compte" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock x:Name="AccountUserText" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource GhostButton}" Content="Options de connexion (Windows Hello)"
                                                    Tag="ms-settings:signinoptions" Click="OnOpenSetting" Margin="0,0,10,0"/>
                                            <Button Style="{StaticResource GhostButton}" Content="Verrouillage dynamique"
                                                    Tag="ms-settings:lockscreen" Click="OnOpenSetting"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Contrôle parental -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="👪 Contrôle parental" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Temps d'écran, filtrage de contenu et rapports d'activité (Microsoft Family)."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,8"/>
                                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                Content="Ouvrir le contrôle parental" Tag="https://family.microsoft.com" Click="OnOpenSetting"/>
                                    </StackPanel>
                                </Border>

                                <!-- Performances & intégrité -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="💚 Performances &amp; intégrité" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock x:Name="PerfDiskText" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,2"/>
                                        <TextBlock x:Name="PerfRamText" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource GhostButton}" Content="Windows Update"
                                                    Tag="ms-settings:windowsupdate" Click="OnOpenSetting" Margin="0,0,10,0"/>
                                            <Button x:Name="PerfRefreshButton" Style="{StaticResource GhostButton}"
                                                    Content="Actualiser" Click="OnRefreshPerf"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- =============== PAGE : PÉRIPHÉRIQUES =============== -->
                    <Grid x:Name="PageDevices" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Périphériques" Style="{StaticResource PageTitle}"/>
                            <Button x:Name="DevicesRefreshButton" Style="{StaticResource GhostButton}" Content="Actualiser"
                                    Click="OnRefreshDevices" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DevicesStatus" Text="Imprimantes, scanners, disques, USB — et accès aux outils Windows."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Rechercher / ajouter + accès rapides -->
                                <TextBlock Text="Rechercher &amp; ajouter / Outils Windows" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                                <WrapPanel x:Name="DeviceToolsGrid" Margin="0,0,0,16"/>

                                <!-- Imprimantes -->
                                <TextBlock Text="🖨️ Imprimantes installées" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="PrintersList" Margin="0,0,0,16">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="{Binding Sub}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="File d'attente" Style="{StaticResource GhostButton}"
                                                            Click="OnOpenPrinterQueue" Tag="{Binding Name}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Disques & USB -->
                                <TextBlock Text="💽 Disques &amp; périphériques de stockage (USB inclus)" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="DrivesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="{Binding Sub}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <ProgressBar Grid.Column="1" Style="{StaticResource Meter}" Height="8" Maximum="100"
                                                                 Value="{Binding UsedPct}" Foreground="{Binding Color}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <Button Grid.Column="2" Content="Ouvrir" Style="{StaticResource GhostButton}"
                                                            Click="OnOpenDrive" Tag="{Binding Path}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- =============== PAGE : OPTIMISATION =============== -->
                    <Grid x:Name="PageOptimize" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Optimisation du système" Style="{StaticResource PageTitle}"/>
                            <TextBlock x:Name="OptimizeStatus" Text="Nettoyage, accélération et outils Windows intégrés."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Button Style="{StaticResource PrimaryButton}" Height="50" Margin="0,0,0,12"
                                        Click="OnOptimize" Tag="boost" Content="⚡  OPTIMISATION RAPIDE (RAM + temp + DNS + corbeille)"/>
                                <WrapPanel x:Name="OptimizeGrid">
                                    <!-- Les boutons d'options sont générés ici par le code. -->
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- =============== PAGE : TIMELINE DE SÉCURITÉ =============== -->
                    <Grid x:Name="PageTimeline" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Timeline de sécurité" Style="{StaticResource PageTitle}"/>
                            <Button x:Name="TimelineRefreshButton" Style="{StaticResource GhostButton}" Content="Actualiser"
                                    Click="OnRefreshTimeline" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TimelineStatus" Text="Historique de mission : chaque évènement de sécurité, du plus récent au plus ancien."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TimelineList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11" FontFamily="Consolas" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                            <!-- Rail + point -->
                                            <Grid Grid.Column="1">
                                                <Border Width="2" Background="#1E3A52" HorizontalAlignment="Center"/>
                                                <Ellipse Width="12" Height="12" Fill="{Binding Dot}" VerticalAlignment="Top" Margin="0,8,0,0">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#22D3E8" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </Grid>
                                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,4,0,8" Padding="12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{Binding Sub}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- =============== PAGE : RADAR DE MENACES =============== -->
                    <Grid x:Name="PageThreatRadar" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Radar de menaces" Style="{StaticResource PageTitle}"/>
                            <TextBlock x:Name="ThreatRadarStatus" Text="Balayage continu — chaque point est une menace ou un incident."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                            <Canvas x:Name="ThreatRadarCanvas" ClipToBounds="True" Background="Transparent"/>
                        </Border>
                    </Grid>

                    <!-- =============== PAGE : ADN / INDICE DE CONFIANCE =============== -->
                    <Grid x:Name="PageDna" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="ADN des programmes — indice de confiance" Style="{StaticResource PageTitle}"/>
                            <Button x:Name="DnaRefreshButton" Style="{StaticResource GhostButton}" Content="Actualiser"
                                    Click="OnRefreshDna" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DnaStatus" Text="Profil de chaque programme au démarrage : signature, éditeur, emplacement, âge."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DnaList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="170"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Publisher}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Line}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ScoreText}" Foreground="{Binding ScoreColor}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                    <ProgressBar Style="{StaticResource Meter}" Height="8" Maximum="100" Value="{Binding Score}"
                                                                 Foreground="{Binding ScoreColor}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- =============== PAGE : CARTE MONDIALE =============== -->
                    <Grid x:Name="PageWorld" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Carte mondiale des connexions" Style="{StaticResource PageTitle}"/>
                            <Button x:Name="WorldRefreshButton" Style="{StaticResource GhostButton}" Content="Actualiser"
                                    Click="OnRefreshWorld" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="WorldStatus" Text="Connexions sortantes géolocalisées en direct."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                            <Canvas x:Name="WorldCanvas" ClipToBounds="True" Background="Transparent"/>
                        </Border>
                    </Grid>

                    <!-- =============== PAGE : PROCESSUS (graphe temps réel) =============== -->
                    <Grid x:Name="PageProcesses" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Vue système — processus en direct" Style="{StaticResource PageTitle}"/>
                            <Button x:Name="ProcRefreshButton" Style="{StaticResource GhostButton}" Content="Actualiser"
                                    Click="OnRefreshProcesses" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProcStatus" Text="Chaque nœud = un processus. Rouge = non signé / suspect."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                            <Canvas x:Name="ProcCanvas" ClipToBounds="True" Background="Transparent"/>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Détails du processus" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                                <TextBlock x:Name="ProcDetail" Text="Cliquez un nœud pour voir les détails."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- =============== PAGE : RADAR RÉSEAU =============== -->
                    <Grid x:Name="PageRadar" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Radar du réseau local" Style="{StaticResource PageTitle}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                            <Button x:Name="RadarButton" Style="{StaticResource PrimaryButton}" Width="200"
                                    Content="LANCER LE RADAR" Click="OnRadarScan"/>
                            <TextBlock x:Name="RadarStatus" Text="Détecte appareils, ports ouverts, caméras IP, NAS et objets connectés vulnérables."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Écran radar « tour de contrôle » -->
                            <Border Grid.Column="0" Width="440" Margin="0,0,10,0" CornerRadius="14"
                                    Background="#02160B" BorderBrush="#0C5" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#11FF66" BlurRadius="28" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                                <Grid>
                                    <Canvas x:Name="NetRadarCanvas" ClipToBounds="True" Background="Transparent"/>
                                    <TextBlock x:Name="NetRadarLegend" Text="🟢 connu / sûr   🔴 nouveau ou à risque"
                                               Foreground="#66FF99" FontSize="11" FontFamily="Consolas"
                                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}">
                            <ListBox x:Name="RadarList" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#22FFFFFF" CornerRadius="8" Padding="12" Margin="0,3"
                                                BorderBrush="{Binding BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Ip}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Mac}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="0,1,0,0"/>
                                                    <Border Background="#F59E0B" CornerRadius="4" Padding="5,1" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                            Visibility="{Binding NewVisibility}">
                                                        <TextBlock Text="NOUVEAU" Foreground="#0A1726" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <Border CornerRadius="5" Padding="7,2" HorizontalAlignment="Left" Margin="0,0,0,4"
                                                            Background="#0E2233" BorderThickness="1" BorderBrush="{Binding ScoreColor}">
                                                        <TextBlock Text="{Binding ScoreText}" Foreground="{Binding ScoreColor}" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding NameLine}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding PortsLine}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                    <ItemsControl ItemsSource="{Binding Risks}" Margin="0,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" Foreground="#FF6B6B" FontSize="10" TextWrapping="Wrap" Margin="0,1"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- Barre d'actions de correction (appareils à risque) -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding ActionsVisibility}">
                                                        <Button Content="Ouvrir l'interface" Style="{StaticResource GhostButton}" Height="30"
                                                                Click="OnRadarOpenAdmin" Tag="{Binding}" Margin="0,0,6,0"/>
                                                        <Button Content="Bloquer (pare-feu)" Style="{StaticResource GhostButton}" Height="30"
                                                                Click="OnRadarBlock" Tag="{Binding}" Margin="0,0,6,0"/>
                                                        <Button Content="Débloquer" Style="{StaticResource GhostButton}" Height="30"
                                                                Click="OnRadarUnblock" Tag="{Binding}" Margin="0,0,6,0"/>
                                                        <Button Content="Conseils (IA)" Style="{StaticResource GhostButton}" Height="30"
                                                                Click="OnRadarAdvice" Tag="{Binding}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ===================== PAGE : VPN ==================== -->
                    <Grid x:Name="PageVpn" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="VPN" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Connexion sécurisée via le serveur VPN de votre NAS Synology (ou tout serveur L2TP/IPSec, SSTP ou PPTP). Utilise le client VPN intégré à Windows."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,10"/>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <!-- Profils enregistrés -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Profil VPN (sélectionner ou nommer pour enregistrer)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                <ComboBox x:Name="VpnProfileBox" IsEditable="True" Margin="0,3,0,0"
                                                          SelectionChanged="OnVpnProfileSelected"/>
                                            </StackPanel>
                                            <Button x:Name="VpnSaveProfileButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                                    Content="Enregistrer" Click="OnVpnSaveProfile" Margin="8,16,0,0" VerticalAlignment="Top"/>
                                            <Button x:Name="VpnDeleteProfileButton" Grid.Column="2" Style="{StaticResource GhostButton}"
                                                    Content="Supprimer" Click="OnVpnDeleteProfile" Margin="8,16,0,0" VerticalAlignment="Top"/>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Ellipse x:Name="VpnDot" Width="12" Height="12" Fill="#64748B" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="VpnStatus" Text="Déconnecté" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock x:Name="VpnIpText" Grid.Column="1" Text="" Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Adresse du serveur (IP ou DNS du NAS)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                <TextBox x:Name="VpnServer" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                         BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Type" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                <ComboBox x:Name="VpnType" Margin="0,3,0,0" SelectedIndex="0"
                                                          SelectionChanged="OnVpnTypeChanged">
                                                    <ComboBoxItem Content="L2TP/IPSec"/>
                                                    <ComboBoxItem Content="SSTP"/>
                                                    <ComboBoxItem Content="PPTP"/>
                                                    <ComboBoxItem Content="Automatique"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Nom d'utilisateur" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                <TextBox x:Name="VpnUser" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                         BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Mot de passe" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                <PasswordBox x:Name="VpnPassword" Background="#0A1726"
                                                             BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel x:Name="VpnPskPanel" Margin="0,10,0,0">
                                            <TextBlock Text="Clé pré-partagée (L2TP/IPSec — « Clé secrète » du NAS)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                            <PasswordBox x:Name="VpnPsk" Background="#0A1726"
                                                         BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button x:Name="VpnConnectButton" Style="{StaticResource PrimaryButton}"
                                                    Content="SE CONNECTER" Click="OnVpnConnect" Width="170"/>
                                            <Button x:Name="VpnDisconnectButton" Style="{StaticResource GhostButton}"
                                                    Content="Déconnecter" Click="OnVpnDisconnect" Margin="10,0,0,0" IsEnabled="False"/>
                                            <CheckBox x:Name="VpnSaveCreds" Content="Mémoriser (chiffré)" Foreground="{StaticResource TextMutedBrush}"
                                                      VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11" IsChecked="True"/>
                                        </StackPanel>
                                        <TextBlock x:Name="VpnLog" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- État de la connexion en direct -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="État de la connexion en direct" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Débit descendant -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="↓ Débit entrant" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                <TextBlock x:Name="VpnDownRate" Text="—" Foreground="{StaticResource GreenBrush}" FontSize="24" FontWeight="Bold"/>
                                                <TextBlock x:Name="VpnDownTotal" Text="Reçu : —" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                            </StackPanel>
                                            <!-- Débit montant -->
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="↑ Débit sortant" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                <TextBlock x:Name="VpnUpRate" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="24" FontWeight="Bold"/>
                                                <TextBlock x:Name="VpnUpTotal" Text="Envoyé : —" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource PanelStrokeBrush}" Margin="0,12"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Connexion :" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,12,2"/>
                                            <TextBlock x:Name="VpnLiveState" Grid.Row="0" Grid.Column="1" Text="Déconnecté" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,2"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Durée :" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,12,2"/>
                                            <TextBlock x:Name="VpnUptime" Grid.Row="1" Grid.Column="1" Text="—" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,2"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="IP locale (VPN) :" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,12,2"/>
                                            <TextBlock x:Name="VpnLocalIpText" Grid.Row="2" Grid.Column="1" Text="—" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="11" Margin="0,2"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="IP publique :" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,12,2"/>
                                            <TextBlock x:Name="VpnPublicIpText" Grid.Row="3" Grid.Column="1" Text="—" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="11" Margin="0,2"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Pays / ville :" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,12,2"/>
                                            <TextBlock x:Name="VpnCountryText" Grid.Row="4" Grid.Column="1" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,2"/>
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Opérateur :" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,12,2"/>
                                            <TextBlock x:Name="VpnIspText" Grid.Row="5" Grid.Column="1" Text="—" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,2" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ================= PAGE : COFFRE-FORT ================= -->
                    <Grid x:Name="PageVault" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Coffre-fort" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Stockez vos mots de passe, chiffrés sur votre PC (DPAPI). Rien n'est envoyé sur Internet."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"/>
                        </StackPanel>

                        <!-- Formulaire d'ajout -->
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Ajouter une entrée" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Titre (ex. Gmail)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        <TextBox x:Name="VaultTitle" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Identifiant / e-mail" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        <TextBox x:Name="VaultUser" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Mot de passe" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        <TextBox x:Name="VaultPassword" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Site / URL (optionnel)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        <TextBox x:Name="VaultUrl" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Notes (optionnel)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                        <TextBox x:Name="VaultNotes" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                                 BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" Margin="0,3,0,0" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="VaultGenButton" Grid.Column="3" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom"
                                            Content="Générer" Click="OnVaultGenerate" Margin="10,0,0,0"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="VaultAddButton" Style="{StaticResource PrimaryButton}" Content="AJOUTER AU COFFRE" Click="OnVaultAdd" Width="200"/>
                                    <Button x:Name="VaultImportButton" Style="{StaticResource GhostButton}" Content="Importer CSV (Google/Edge/Chrome)" Click="OnVaultImportCsv" Margin="10,0,0,0"/>
                                    <Button x:Name="VaultImportBrowserButton" Style="{StaticResource GhostButton}" Content="Importer depuis le navigateur" Click="OnVaultImportBrowser" Margin="8,0,0,0"/>
                                    <Button x:Name="VaultExportButton" Style="{StaticResource GhostButton}" Content="Exporter (protégé)" Click="OnVaultExport" Margin="8,0,0,0"/>
                                    <TextBlock x:Name="VaultStatus" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Liste des entrées -->
                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
                            <ListBox x:Name="VaultList" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#22FFFFFF" CornerRadius="8" Padding="12" Margin="0,3"
                                                BorderBrush="#3344E0FF" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{Binding Username}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding DisplayPassword}" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="12" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Url}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"
                                                               Visibility="{Binding UrlVisibility}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource GhostButton}" Content="Afficher" Click="OnVaultReveal" Tag="{Binding}" Margin="0,0,6,0"/>
                                                    <Button Style="{StaticResource GhostButton}" Content="Copier id." Click="OnVaultCopyUser" Tag="{Binding}" Margin="0,0,6,0"/>
                                                    <Button Style="{StaticResource GhostButton}" Content="Copier m.d.p." Click="OnVaultCopyPassword" Tag="{Binding}" Margin="0,0,6,0"/>
                                                    <Button Style="{StaticResource GhostButton}" Content="Supprimer" Click="OnVaultDelete" Tag="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- ============ PAGE : CENTRE DE SÉCURITÉ ============ -->
                    <Grid x:Name="PageCentre" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Centre de sécurité" Style="{StaticResource PageTitle}"/>

                                <!-- Score de sécurité -->
                                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Width="150" VerticalAlignment="Center">
                                            <TextBlock x:Name="ScoreValue" Text="—" Foreground="{StaticResource AccentBrush}"
                                                       FontSize="56" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="sur 100" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="ScoreGrade" Text="" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"
                                                       FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                                            <Button x:Name="ScoreRefreshButton" Style="{StaticResource GhostButton}" Content="Évaluer"
                                                    Click="OnComputeScore" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                            <TextBlock Text="Score de sécurité du PC" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="Note globale et recommandations personnalisées." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,8"/>
                                            <ItemsControl x:Name="ScoreList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" Foreground="{Binding Color}" FontWeight="Bold" Width="22"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                                                <TextBlock Text="{Binding Advice}" Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                                                                           TextWrapping="Wrap" Visibility="{Binding AdviceVisibility}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Mode Panic -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0" BorderBrush="#E5484D" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🚨 Mode Panic" Foreground="#FF6B6B" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="En cas d'urgence : coupe Internet, bloque les périphériques USB, arrête les processus suspects (lancés depuis les dossiers temporaires/Téléchargements) et verrouille la session. Réversible."
                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="PanicButton" Content="ACTIVER LE MODE PANIC" Click="OnPanicEngage"
                                                    Background="#E5484D" Foreground="White" BorderThickness="0" Padding="16,9" Cursor="Hand" FontWeight="Bold"/>
                                            <Button x:Name="PanicOffButton" Style="{StaticResource GhostButton}" Content="Rétablir (réseau + USB)"
                                                    Click="OnPanicDisengage" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="PanicStatus" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Surveillance du presse-papiers -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="📋 Surveillance du presse-papiers (anti-arnaque crypto)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="Détecte les malwares qui remplacent une adresse de cryptomonnaie copiée par celle d'un pirate." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ClipboardGuardSwitch" Grid.Column="1" Content="Activé" IsChecked="True"
                                                      Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Click="OnToggleClipboardGuard"/>
                                        </Grid>
                                        <TextBlock x:Name="ClipboardStatus" Text="En attente d'une copie d'adresse crypto…" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Protection webcam & micro -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="📷 Protection webcam &amp; micro" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="Liste les applications qui utilisent (ou ont utilisé) votre caméra et votre microphone." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button x:Name="MediaScanButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="Vérifier" Click="OnScanMedia" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ItemsControl x:Name="MediaList" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Device}" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding App}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding Color}" FontSize="10" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="MediaStatus" Text="" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Mode Gamer -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="🎮 Mode Gamer" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="Suspend les notifications et allège l'analyse, sans jamais désactiver la protection." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="GamerModeSwitch" Grid.Column="1" Content="Activé"
                                                      Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Click="OnToggleGamerMode"/>
                                        </Grid>
                                        <TextBlock x:Name="GamerStatus" Text="Désactivé." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ======== PAGE : CENTRE D'INVESTIGATION ======== -->
                    <Grid x:Name="PageInvestigation" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Centre d'investigation" Style="{StaticResource PageTitle}"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,8">
                            <Button x:Name="InvRefreshButton" Style="{StaticResource PrimaryButton}" Content="Actualiser la chronologie" Click="OnRefreshInvestigation"/>
                            <Button x:Name="InvExportButton" Style="{StaticResource GhostButton}" Content="Exporter le rapport" Click="OnExportInvestigation" Margin="10,0,0,0"/>
                            <Button x:Name="InvClearButton" Style="{StaticResource GhostButton}" Content="Vider" Click="OnClearInvestigation" Margin="8,0,0,0"/>
                            <TextBlock x:Name="InvStatus" Text="Chronologie horodatée des évènements de sécurité." Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <ListBox x:Name="InvList" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Pastille + ligne de temps -->
                                            <StackPanel Grid.Column="0" Width="14" HorizontalAlignment="Center">
                                                <Ellipse Width="12" Height="12" Fill="{Binding Color}"/>
                                                <Rectangle Width="2" Fill="#2A3B55" VerticalAlignment="Stretch" Height="40" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#22FFFFFF" CornerRadius="8" Padding="10" Margin="8,0,0,0"
                                                    BorderBrush="{Binding Color}" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentBrush}" FontSize="9" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- ========== PAGE : JUMEAU NUMÉRIQUE ========== -->
                    <Grid x:Name="PageTwin" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Jumeau numérique &amp; ADN des logiciels" Style="{StaticResource PageTitle}"/>
                        <TextBlock Grid.Row="1" Text="Capture une empreinte complète du système (applications + versions, services, pilotes, démarrage, tâches, fichier hosts) et détecte toute modification anormale — même sans malware connu."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="TwinCaptureButton" Style="{StaticResource GhostButton}" Content="Capturer l'empreinte de référence" Click="OnTwinCapture"/>
                            <Button x:Name="TwinCompareButton" Style="{StaticResource PrimaryButton}" Content="Comparer maintenant" Click="OnTwinCompare" Margin="10,0,0,0"/>
                            <TextBlock x:Name="TwinStatus" Text="" Foreground="{StaticResource AccentBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Row="3" Style="{StaticResource Card}">
                            <ListBox x:Name="TwinList" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#22FFFFFF" CornerRadius="8" Padding="10" Margin="0,2" BorderBrush="{Binding Color}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Kind}" Foreground="{Binding Color}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Key}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Change}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- ========== PAGE : TABLEAU D'INTÉGRITÉ ========== -->
                    <Grid x:Name="PageIntegrity" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Tableau de bord d'intégrité" Style="{StaticResource PageTitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                    <TextBlock x:Name="IntegrityOverall" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="34" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="/100" Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Bottom" Margin="2,0,16,6"/>
                                    <Button x:Name="IntegrityRefreshButton" Style="{StaticResource GhostButton}" Content="Actualiser" Click="OnRefreshIntegrity" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="IntegrityStatus" Text="Santé globale du PC en temps réel." Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </StackPanel>
                                <!-- ====== NIVEAU DE SÉCURITÉ (animé, données réelles) ====== -->
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22">
                                    <StackPanel>
                                        <TextBlock Text="NIVEAU DE SÉCURITÉ" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                        <Grid Margin="0,8,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar x:Name="SecGlobalMeter" Grid.Column="0" Style="{StaticResource Meter}"
                                                         Height="20" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SecGlobalPct" Grid.Column="1" Text="—"
                                                       Foreground="{StaticResource AccentBrush}" FontSize="30" FontWeight="Bold"
                                                       Margin="16,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel x:Name="SecBars" Margin="0,14,0,0"/>
                                        <TextBlock x:Name="SecThreatLine" Text="✓ Aucune menace active"
                                                   Foreground="{StaticResource GreenBrush}" FontSize="14" FontWeight="SemiBold"
                                                   Margin="0,14,0,0"/>
                                    </StackPanel>
                                </Border>

                                <ItemsControl x:Name="IntegrityList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Width="210" Height="120" Margin="0,0,12,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Display}" Foreground="{Binding Color}" FontSize="34" FontWeight="Bold" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- =============== PAGE : COPILOTE IA ================ -->
                    <Grid x:Name="PageCopilot" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1.25*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Conversation -->
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="🤖 Copilote cybersécurité" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock x:Name="CopilotHint" Text="Propulsé par Claude. Posez une question ou laissez-le vous alerter en cas d'activité suspecte."
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ChatList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Bubble}" CornerRadius="10" Padding="10,8" Margin="0,4"
                                                        HorizontalAlignment="{Binding Align}" MaxWidth="460">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Sender}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ChatInput" Grid.Column="0" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource PanelStrokeBrush}" Padding="8" VerticalContentAlignment="Center"
                                             KeyDown="OnChatKeyDown"/>
                                    <Button x:Name="ChatSendButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Envoyer"
                                            Click="OnChatSend" Margin="8,0,0,0"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Outils IA -->
                        <StackPanel Grid.Column="2">
                            <!-- Détection d'arnaques -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="🎣 Détecter une arnaque" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Collez un e-mail, un SMS ou une URL : l'IA repère le phishing." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                    <TextBox x:Name="ScamInput" Background="#0A1726" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource PanelStrokeBrush}"
                                             Padding="8" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                    <Button x:Name="ScamButton" Style="{StaticResource GhostButton}" Content="Analyser" Click="OnAnalyzeScam" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="ScamResult" Text="" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Analyse prédictive -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="🔮 Analyse prédictive d'un fichier" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="Estime la probabilité qu'un fichier soit malveillant, avant toute signature." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                    <Button x:Name="PredictButton" Style="{StaticResource GhostButton}" Content="Choisir un fichier…" Click="OnPredictFile" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="PredictResult" Text="" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- =================== PAGE : APPAREIL ================== -->
                    <Grid x:Name="PageDevice" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Sécurité des appareils" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="État de la sécurité matérielle intégrée à votre appareil."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,8"/>
                                <Button x:Name="DeviceCheckButton" Style="{StaticResource PrimaryButton}" Width="220"
                                        HorizontalAlignment="Left" Content="VÉRIFIER L'ÉTAT" Click="OnCheckDevice"/>

                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🧩 Isolation du noyau" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Protège le noyau Windows contre les attaques mémoire." Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="CoreIsolationStatus" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🔐 Processeur de sécurité (TPM)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Module de plateforme sécurisée — chiffrement matériel." Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="TpmStatus" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,6,0,6"/>
                                        <Button x:Name="OpenTpmButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                Content="Ouvrir la gestion du TPM" Click="OnOpenTpm"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="🛡️ Démarrage sécurisé (Secure Boot)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Empêche le chargement de logiciels non signés au démarrage." Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="SecureBootStatus" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="💾 Chiffrement de données (BitLocker)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Protège vos données en cas de perte ou de vol de l'appareil." Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                        <TextBlock x:Name="BitLockerStatus" Text="—" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,6,0,6"/>
                                        <Button x:Name="OpenBitlockerButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                                Content="Gérer le chiffrement BitLocker" Click="OnOpenBitlocker"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>

            <!-- ============================ PIED DE PAGE ============================ -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="#070F1A"
                    CornerRadius="0,0,16,16" BorderBrush="{StaticResource PanelStrokeBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Height="44">
                        <TextBlock Text="Powered by " Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="IATECHFUTUR" Foreground="{StaticResource AccentBrush}"
                                   FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="®" Foreground="{StaticResource AccentBrush}" FontSize="9"
                                   VerticalAlignment="Top" Margin="1,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="©" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text=" 2026 IATECHFUTUR — Tous droits réservés." Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============= VERROU « LICENCE REQUISE » (essai expiré) ============= -->
            <!-- Recouvre toute la fenêtre quand les 15 jours d'essai sont terminés :
                 le logiciel reste figé sur le dashboard jusqu'à l'achat / activation. -->
            <Border x:Name="LicenseLockOverlay" Grid.Row="0" Grid.RowSpan="2"
                    Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="16"
                    Panel.ZIndex="9999" Visibility="Collapsed">
                <Border.Background>
                    <SolidColorBrush Color="#070F1A" Opacity="0.97"/>
                </Border.Background>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540">
                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="72"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Licence requise" FontSize="34" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock Text="Votre période d'essai de 15 jours est terminée."
                               FontSize="15" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    <TextBlock Text="Veuillez acheter une licence sur la boutique IATECHFUTUR pour continuer à utiliser IATECH-SHIELD PRO."
                               FontSize="14" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                        <Button Content="🛒  Acheter une licence" Style="{StaticResource PrimaryButton}"
                                Click="OnBuyLicenseFromLock" MinWidth="220"/>
                        <Button Content="J'ai déjà une clé" Style="{StaticResource GhostButton}"
                                Click="OnActivateFromLock" Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="iatechfutur.be" FontSize="12" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RingRotate" Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:18" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="OrbitRotate" Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:26" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="CoreGlow" Storyboard.TargetProperty="Opacity"
                                     From="0.25" To="0.8" Duration="0:0:1.4" AutoReverse="True"
                                     RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
